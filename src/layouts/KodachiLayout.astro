---
/**
 * Standalone document for the fictional landscaper.
 * Does not load the team-site layout or global.css.
 * The sample note, the footer, and each image alt say the photos are AI-generated.
 */
interface Props {
  title: string;
  description: string;
  current: 'top' | 'care' | 'build' | 'examples' | 'about' | 'contact';
}

const { title, description, current } = Astro.props;
const nav = [
  { id: 'top', href: '/lp/kodachi/', label: 'トップ' },
  { id: 'care', href: '/lp/kodachi/care/', label: '手入れ・剪定' },
  { id: 'build', href: '/lp/kodachi/build/', label: '庭づくり' },
  { id: 'examples', href: '/lp/kodachi/examples/', label: '施工の例' },
  { id: 'about', href: '/lp/kodachi/about/', label: '会社案内' },
  { id: 'contact', href: '/lp/kodachi/contact/', label: '問い合わせ' },
] as const;
const phone = '000-0000-0000';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜木立造園（架空のサンプル）</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="note" role="note">
      <p class="note-text">
        <span class="badge">架空のサンプル</span>
        <span class="note-full">「木立造園」は実在しません。写真は AI で生成した画像です。</span>
        <span class="note-short">実在しません。写真はAI生成です。</span>
      </p>
      <p class="note-links">
        <a href="/works/sample-kodachi/">解説を見る</a>
        <a href="/">michixsa のトップへ戻る</a>
      </p>
    </div>
    <header class="head">
      <a class="logo" href="/lp/kodachi/">木立造園</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="label-closed">メニュー</span>
        <span class="label-open">閉じる</span>
      </button>
      <nav id="site-nav" class="nav" aria-label="サイト">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="nav-phone" href={`tel:${phone}`}>電話 {phone}</a>
          </li>
        </ul>
      </nav>
      <a class="head-phone" href={`tel:${phone}`}>{phone}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <p class="foot-name">木立造園</p>
      <p>〒000-0000 架空県サンプル市こだち2-8</p>
      <p>電話 <a href={`tel:${phone}`}>{phone}</a></p>
      <p>メール info@example.com</p>
      <p><a href="/lp/kodachi/legacy/">作り直す前のページ（再現）</a></p>
      <p>写真は AI で生成した画像です。</p>
    </footer>
    <noscript>
      <style>
        .menu-btn { display: none !important; }
        #site-nav { display: block !important; position: static !important; }
      </style>
    </noscript>
    <script>
      const button = document.querySelector('.menu-btn');
      const nav = document.getElementById('site-nav');
      if (button instanceof HTMLButtonElement && nav) {
        const setOpen = (open: boolean) => {
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
          nav.classList.toggle('is-open', open);
        };
        button.addEventListener('click', () => {
          setOpen(button.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          if (button.getAttribute('aria-expanded') !== 'true') return;
          setOpen(false);
          button.focus();
        });
        const desktop = window.matchMedia('(min-width: 1120px)');
        desktop.addEventListener('change', () => {
          if (desktop.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f4f1ea;
    --surface: #fffdf8;
    --ink: #1f2a22;
    --muted: #5a554c;
    --line: #7f786c;
    --moss: #2c4a38;
    --moss-hover: #243e2f;
    --bar: #1e3a5f;
    --focus: #2c4a38;
    --serif: "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", YuMincho, "Hiragino Mincho", "Noto Serif CJK JP", "Noto Serif JP", "MS PMincho", serif;
    --sans: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "BIZ UDPGothic", "Noto Sans JP", "Noto Sans CJK JP", "Yu Gothic", YuGothic, Meiryo, sans-serif;
  }
  *,
  *::before,
  *::after { box-sizing: border-box; }
  html { scroll-padding-top: 96px; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
  }
  img { max-width: 100%; display: block; }
  p { margin: 0 0 16px; }
  a { color: var(--moss); }
  a:visited { color: var(--moss); }
  h1, h2, h3, .lead, .phases p, .summary li {
    word-break: auto-phrase;
  }
  h1, h2, h3 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.35;
    font-feature-settings: "palt";
  }
  h1 { margin: 0 0 16px; font-size: 32px; }
  h2 { margin: 0 0 16px; font-size: 20px; line-height: 1.4; }
  h3 { margin: 12px 0 8px; font-size: 18px; line-height: 1.4; }
  .lead { margin: 0 0 24px; font-size: 18px; }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .note {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 16px;
    min-height: 40px;
    padding: 0 16px;
    background: var(--bar);
    color: #fff;
    font-size: 14px;
    line-height: 1.4;
  }
  .note p { margin: 0; }
  .note-text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 4px 0;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 0 8px;
    background: #fff;
    color: var(--bar);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
  .note-full { display: none; }
  .note-links { display: flex; flex-wrap: wrap; }
  .note a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 8px;
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .note a:visited { color: #fff; }
  .note a:focus-visible { outline-color: #fff; }

  .head {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding: 0 16px;
    background: var(--paper);
  }
  .logo {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    min-height: 48px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    font-feature-settings: "palt";
  }
  .logo:visited { color: var(--ink); }
  .logo:hover { text-decoration: underline; text-underline-offset: 4px; }
  .menu-btn {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
  }
  .menu-btn .label-open { display: none; }
  .menu-btn[aria-expanded='true'] .label-closed { display: none; }
  .menu-btn[aria-expanded='true'] .label-open { display: inline; }
  .nav {
    display: none;
    position: absolute;
    z-index: 30;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--paper);
  }
  .nav.is-open {
    display: block;
    padding: 4px 8px 12px;
    border-bottom: 1px solid var(--line);
  }
  .nav ul {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 8px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:visited { color: var(--ink); }
  .nav a:hover,
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .head-phone { display: none; }
  .nav-phone,
  .head-phone { font-variant-numeric: tabular-nums; }

  .narrow,
  .wide,
  .photo-lead,
  .care-photos {
    margin-right: 16px;
    margin-left: 16px;
  }
  .narrow { max-width: 40rem; }
  .photo-lead { max-width: 56rem; margin-top: 8px; }
  .care-photos {
    display: grid;
    gap: 16px;
    max-width: 72rem;
    margin-top: 8px;
  }
  .page-intro { padding-top: 32px; }
  .block { margin-top: 48px; }

  .hero-copy {
    width: min(40rem, calc(100% - 32px));
    margin: 24px auto 0;
  }
  .hero-photo { aspect-ratio: 4 / 5; }
  .hero-photo img { object-position: center center; }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    background: #e4dfd4;
  }
  .frame picture,
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .frame img { object-fit: cover; }
  .ratio-16-9 { aspect-ratio: 16 / 9; }
  .ratio-4-3 { aspect-ratio: 4 / 3; }
  .ratio-4-5 { aspect-ratio: 4 / 5; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 6px;
    background: var(--moss);
    color: #fff;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .btn:visited { color: #fff; }
  .btn:hover { background: var(--moss-hover); }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--moss);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .text-link:visited { color: var(--moss); }
  .text-link:hover { color: var(--moss-hover); }

  .pair, .strip, .summary, .phases, .flow, .examples {
    min-width: 0;
  }
  .pair {
    display: grid;
    gap: 32px;
  }
  .pair > * { min-width: 0; }
  .strip {
    display: grid;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strip > * { min-width: 0; }
  .shot {
    display: flex;
    flex-direction: column;
    color: var(--moss);
    text-decoration: none;
  }
  .shot:visited { color: var(--moss); }
  .shot-label {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 4px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .shot:hover .shot-label { color: var(--moss-hover); }

  .summary, .phases, .flow {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .summary {
    display: grid;
    gap: 12px 16px;
    margin-bottom: 8px;
  }
  .summary li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-height: 48px;
    padding-top: 8px;
    border-top: 2px solid var(--moss);
  }
  .phases {
    display: grid;
    gap: 24px;
    margin-bottom: 24px;
  }
  .phases li {
    min-width: 0;
    padding-top: 12px;
    border-top: 2px solid var(--moss);
  }
  .phases h2 { margin-bottom: 8px; font-size: 18px; }
  .phases p { margin: 0; }
  .flow {
    display: grid;
    gap: 12px;
  }
  .flow li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding-top: 8px;
    border-top: 2px solid var(--moss);
    font-weight: 700;
  }
  .n {
    color: var(--moss);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    min-width: 1.25em;
  }
  .phases .n {
    display: block;
    margin: 0 0 4px;
    font-size: 14px;
  }

  .heights { margin: 0 0 24px; }
  .bars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    height: 140px;
    border-bottom: 1px solid var(--line);
  }
  .bars span {
    display: block;
    width: 36px;
    margin: 0 auto;
    background: var(--moss);
  }
  .bars .h-low { height: 36px; }
  .bars .h-mid { height: 78px; }
  .bars .h-high { height: 132px; }
  .bar-names {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    text-align: center;
  }
  .bar-names li { font-weight: 700; }
  .bar-names small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
  }
  .heights figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-variant-numeric: tabular-nums;
  }
  caption {
    caption-side: bottom;
    padding-top: 8px;
    color: var(--muted);
    font-size: 14px;
    text-align: left;
  }
  th, td {
    padding: 12px 8px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
  }
  th { font-weight: 700; }
  .facts th { width: 28%; }
  .prices th { width: 40%; }
  .prices td { text-align: right; white-space: nowrap; }

  label {
    display: block;
    margin: 16px 0 4px;
    font-weight: 700;
  }
  input, textarea {
    width: 100%;
    color: var(--ink);
    font: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  input { min-height: 48px; padding: 0 12px; }
  textarea { min-height: 8rem; padding: 12px; resize: vertical; }
  input[type='file'] {
    padding: 0;
    border: 0;
    background: transparent;
  }
  input[type='file']::file-selector-button {
    min-height: 48px;
    margin-right: 12px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
  }
  #send-note { margin-top: 8px; font-weight: 700; }

  .examples {
    display: grid;
    gap: 48px;
    margin-top: 8px;
  }
  .example { scroll-margin-top: 96px; }
  .example h2 { margin-top: 16px; }

  .foot {
    margin-top: 64px;
    padding: 32px 16px 48px;
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    line-height: 1.7;
  }
  .foot p { margin: 0; }
  .foot-name {
    margin-bottom: 8px;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 600;
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--paper);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .foot a:visited { color: var(--paper); }
  .foot a:focus-visible { outline-color: #fff; }

  @media (min-width: 800px) {
    .pair { grid-template-columns: 1fr 1fr; gap: 40px 24px; }
    .strip { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .care-photos {
      grid-template-columns: 1.35fr 0.85fr;
      align-items: end;
    }
    .flow { grid-template-columns: repeat(3, 1fr); gap: 16px; }
  }
  @media (min-width: 900px) {
    .summary { grid-template-columns: repeat(5, 1fr); }
    .summary li {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
    .phases { grid-template-columns: repeat(5, 1fr); gap: 16px; }
  }
  /* Horizontal nav starts only once the six labels and the phone fit on one line. */
  @media (min-width: 1120px) {
    h1 { font-size: 40px; }
    h2 { font-size: 24px; }
    .phases h2 { font-size: 20px; }
    .note { padding: 0 40px; }
    .note-short { display: none; }
    .note-full { display: inline; }
    .head {
      justify-content: flex-start;
      gap: 16px;
      padding: 0 40px;
    }
    .menu-btn { display: none; }
    .nav,
    .nav.is-open {
      display: block;
      position: static;
      margin-left: auto;
      padding: 0;
      border: 0;
      background: transparent;
    }
    .nav ul {
      flex-direction: row;
      align-items: center;
    }
    .nav a { padding: 0 12px; white-space: nowrap; }
    .nav a.nav-phone { display: none; }
    .head-phone {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      color: var(--ink);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      white-space: nowrap;
    }
    .head-phone:visited { color: var(--ink); }
    .narrow,
    .wide,
    .photo-lead,
    .care-photos {
      margin-right: 40px;
      margin-left: 40px;
    }
    .page-intro { padding-top: 48px; }
    .block { margin-top: 80px; }
    .foot { margin-top: 96px; padding: 48px 40px 64px; }
    .examples { gap: 64px; }
    .hero {
      display: grid;
      grid-template-columns: minmax(30rem, 38rem) minmax(0, 1fr);
      align-items: stretch;
      min-height: 70vh;
    }
    .hero-photo {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: auto;
      min-height: 70vh;
    }
    .hero-copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      grid-column: 1;
      grid-row: 1;
      width: auto;
      margin: 0;
      padding: 48px 32px 48px 40px;
    }
  }
  @media (min-width: 1280px) {
    h1 { font-size: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
