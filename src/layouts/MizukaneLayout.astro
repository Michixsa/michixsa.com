---
/**
 * Standalone pages for the fictional contractor site.
 * Does not use the team site stylesheet.
 */
interface Props {
  title: string;
  description: string;
  current: 'top' | 'service' | 'about' | 'news' | 'contact';
}

const { title, description, current } = Astro.props;
const nav = [
  { id: 'top', href: '/corp/mizukane/', label: 'トップ' },
  { id: 'service', href: '/corp/mizukane/service/', label: '事業内容' },
  { id: 'about', href: '/corp/mizukane/about/', label: '会社概要' },
  { id: 'news', href: '/corp/mizukane/news/', label: 'お知らせ' },
  { id: 'contact', href: '/corp/mizukane/contact/', label: 'お問い合わせ' },
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜みずかね設備（架空のサンプル）</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#2F3A3A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="bar">
      これは架空のサンプルです。「みずかね設備」は実在しません。写真はAIで生成した画像です。
      <a href="/works/sample-corporate/">解説を見る</a>
    </p>
    <header class="head">
      <a class="logo" href="/corp/mizukane/">みずかね設備</a>
      <nav aria-label="サイト">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>みずかね設備</p>
      <p>〒000-0000 架空県サンプル市みずかね3-1</p>
      <p>電話 000-0000-0000</p>
      <p>メール info@example.com</p>
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fbfaf7; color: #22262a; font-family: system-ui, "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", Meiryo, sans-serif; font-size: 16px; line-height: 1.8; }
  img { max-width: 100%; height: auto; display: block; }
  a:focus-visible, button:focus-visible { outline: 3px solid #e8d9a8; outline-offset: 3px; }
  .bar { margin: 0; padding: 12px 20px; background: #7e5f17; color: #fff; font-size: 14px; }
  .bar a { color: #fff; display: inline-flex; align-items: center; min-height: 48px; }
  .head, .foot { background: #2f3a3a; color: #fff; }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 20px; }
  .logo { color: #fff; font-weight: 800; text-decoration: none; min-height: 48px; display: inline-flex; align-items: center; }
  nav { display: flex; flex-wrap: wrap; }
  nav a { color: #e8d9a8; text-decoration: none; display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; font-weight: 700; }
  nav a[aria-current='page'] { color: #fff; box-shadow: inset 0 -3px 0 #e8d9a8; }
  main { width: min(960px, calc(100% - 40px)); margin: 0 auto; padding: 32px 0 64px; }
  h1 { margin: 8px 0 16px; font-size: clamp(30px, 5vw, 44px); line-height: 1.3; }
  h2 { margin: 28px 0 8px; font-size: 24px; line-height: 1.4; }
  h2::before { content: ""; display: inline-block; width: 12px; height: 12px; margin-right: 8px; background: #7e5f17; }
  .lead { font-size: 18px; }
  .muted { color: #5c6166; }
  .grid { display: grid; gap: 16px; }
  .card { border: 1px solid #e6e0d4; border-radius: 12px; padding: 16px; background: #fff; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 12px 8px; border-bottom: 1px solid #e6e0d4; vertical-align: top; }
  th { width: 8rem; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px; background: #2f3a3a; color: #fff; font-weight: 800; text-decoration: none; border: 0; }
  label { display: block; font-weight: 800; margin-top: 12px; }
  input, textarea { width: 100%; font: inherit; padding: 12px; border: 1px solid #cfc6b4; border-radius: 8px; background: #fff; }
  input:focus-visible, textarea:focus-visible { outline: 3px solid #7e5f17; outline-offset: 2px; }
  .hero { display: grid; gap: 20px; align-items: center; }
  .foot { padding: 32px 20px; }
  .foot p { margin: 4px 0; color: #e8d9a8; }
  @media (min-width: 800px) {
    .hero { grid-template-columns: 1.1fr 0.9fr; }
    .grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  }
</style>
