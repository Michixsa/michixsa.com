---
/**
 * Team site layout. Sample LPs and the clinic demo do not use this file.
 */
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Home hero sits under a transparent header. */
  overlayHeader?: boolean;
}

const { title, description = site.description, noindex = false, overlayHeader = false } = Astro.props;
const pageTitle = title ? `${title}｜${site.name}` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;

const nav = [
  { href: '/#services', label: 'できること' },
  { href: '/#samples', label: 'サンプル' },
  { href: '/#flow', label: '進め方' },
  { href: '/pricing/', label: '料金' },
  { href: '/faq/', label: 'よくある質問' },
];

const footer = [
  { href: '/#services', label: 'できること' },
  { href: '/works/', label: 'サンプル' },
  { href: '/pricing/', label: '料金' },
  { href: '/partners/', label: '同業者さまへ' },
  { href: '/faq/', label: 'よくある質問' },
  { href: '/pricing/#terms', label: '取引条件' },
  { href: '/privacy/', label: 'プライバシーポリシー' },
];

function current(href: string) {
  if (href.startsWith('/#')) return false;
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site.url}/og-default.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="michixsa。途中からでも、はじめからでも。" />
    <meta name="theme-color" content="#F6F8F7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {
      path === '/' && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset="/hero/hero-sp-640.avif 640w, /hero/hero-sp-960.avif 960w, /hero/hero-sp-1122.avif 1122w"
          imagesizes="100vw"
          media="not all and ((orientation: landscape) and (min-width: 768px), (min-width: 1024px))"
          fetchpriority="high"
        />
      )
    }
  </head>
  <body class:list={{ home: overlayHeader }}>
    <a class="skip" href="#main">本文へ移動</a>
    <header class:list={['site-header', { 'is-overlay': overlayHeader }]}>
      <div class="wrap header-in">
        <a class="logo" href="/" aria-current={path === '/' ? 'page' : undefined}>
          <span class="logo-mark" aria-hidden="true"></span>{site.name}
        </a>
        <nav class="gnav" aria-label="メインメニュー">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="btn btn-sm btn-primary header-cta" href="/contact/">相談する</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-in">
        <p class="logo logo-foot"><span class="logo-mark" aria-hidden="true"></span>{site.name}</p>
        <nav aria-label="フッターメニュー">
          {footer.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <p class="copy">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
  </body>
</html>
