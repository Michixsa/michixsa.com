---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  cat: string;
  type: string;
  title: string;
  body: string;
  level?: 'h2' | 'h3';
  feature?: boolean;
}

const { href, image, alt, cat, type, title, body, level = 'h3', feature = false } = Astro.props;
const Heading = level;
---

<article class:list={['work-card', { 'work-feature': feature }]}>
  <a class="work-link" href={href}>
    <div class="work-thumb">
      <Image
        src={image}
        alt={alt}
        widths={[480, 768]}
        sizes={feature ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 22vw, 100vw'}
        format="avif"
        quality={50}
        loading="lazy"
      />
      <span class="tag-sample">架空のサンプル</span>
    </div>
    <div class="work-body">
      <p class="work-meta"><span class="cat">{cat}</span><span class="type">{type}</span></p>
      <Heading>{title}</Heading>
      <p>{body}</p>
      <p class="work-note">写真はAI生成画像です</p>
    </div>
  </a>
</article>

<style>
  h2,
  h3 {
    font-size: 18px;
    font-weight: 800;
    color: var(--main);
    line-height: 1.45;
    margin: 0 0 6px;
  }
  .work-feature :global(h2),
  .work-feature :global(h3) {
    font-size: clamp(22px, 2.4vw, 28px);
  }
</style>
