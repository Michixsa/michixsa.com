---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  moreHref: string;
  title: string;
  kind: string;
  body: string;
  note: string;
  tone: 'cafe' | 'kodachi' | 'mizukane' | 'hinata';
  image?: ImageMetadata;
  alt?: string;
  level?: 'h2' | 'h3';
}

const { href, moreHref, title, kind, body, note, tone, image, alt = '', level = 'h3' } = Astro.props;
const Heading = level;
---

<li class="sample-card">
  <a class="sample-main" href={href} data-astro-reload>
    <span class:list={['sample-visual', `ph-${tone}`]}>
      {
        image && (
          <Image
            src={image}
            alt={alt}
            widths={[480, 768]}
            sizes="(min-width: 1024px) 22vw, 100vw"
            format="avif"
            quality={50}
            loading="lazy"
          />
        )
      }
      {!image && <span class="ph-tag">写真の仮置き</span>}
    </span>
    <span class="sample-badges">
      <span class="sample-badge">架空のサンプル</span>
      <span class="sample-note">{note}</span>
    </span>
    <span class="sample-kind">{kind}</span>
    <Heading>{title}</Heading>
    <span class="sample-desc">{body}</span>
  </a>
  <a class="sample-more" href={moreHref}>このサンプルの考え方を読む →</a>
</li>
