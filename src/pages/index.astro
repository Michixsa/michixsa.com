---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SampleCard from '../components/SampleCard.astro';
import cafeCard from '../assets/lp/cafe/banner.webp';
import desk from '../assets/site/team-desk.webp';
import { mailHref } from '../data/site';
import {
  carePlans,
  faqs,
  incidentNote,
  partnerPromises,
  plans,
  priceGroups,
  priceIntro,
  steps,
  strengths,
} from '../data/offer';

const numbered = [
  { n: '01', title: 'LP・ホームページ制作', body: 'お店や会社の、1ページから数ページのサイト。' },
  { n: '02', title: '業務システム・管理画面', body: '紙や表計算の作業を、ブラウザで使える画面に。' },
  { n: '03', title: '既存の改修', body: 'いま動いているサイトやシステムに、足す・直す。' },
  { n: '04', title: 'サーバー・クラウド構築', body: 'サイトやシステムを載せる場所を、お客様の名義で。' },
  { n: '05', title: '保守・運用・障害対応', body: '公開したあとも、止まっていないかを見守る。' },
  { n: '06', title: '移転・リニューアル', body: '古いサーバーからの引っ越しや、作り直し。' },
];

const consultHref = mailHref(
  'ご相談',
  '作りたいもの：\n希望の時期：\nいまのサイトやサーバーの有無：\n',
);
const partnerHref = mailHref(
  '【同業者さま】ご相談',
  'ご依頼したい工程：\n希望の時期：\n秘密保持契約の要否：\n',
);
---

<BaseLayout overlayHeader>
  <section class="hero-full" id="top" aria-labelledby="hero-title">
    <picture class="hero-photo">
      <source
        media="(orientation: landscape) and (min-width: 768px), (min-width: 1024px)"
        type="image/avif"
        srcset="/hero/hero-pc-1280.avif 1280w, /hero/hero-pc-1672.avif 1672w"
        sizes="100vw"
      />
      <source
        media="(orientation: landscape) and (min-width: 768px), (min-width: 1024px)"
        type="image/webp"
        srcset="/hero/hero-pc-1280.webp 1280w, /hero/hero-pc-1672.webp 1672w"
        sizes="100vw"
      />
      <source
        type="image/avif"
        srcset="/hero/hero-sp-640.avif 640w, /hero/hero-sp-960.avif 960w, /hero/hero-sp-1122.avif 1122w"
        sizes="100vw"
      />
      <img
        src="/hero/hero-sp-960.webp"
        srcset="/hero/hero-sp-640.webp 640w, /hero/hero-sp-960.webp 960w, /hero/hero-sp-1122.webp 1122w"
        sizes="100vw"
        width="960"
        height="1200"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-copy">
      <p class="eyebrow">
        Web制作・システム開発・サーバー運用<span class="sep" aria-hidden="true">｜</span><span class="area">全国オンライン対応</span>
      </p>
      <h1 id="hero-title"><em>途中から</em>でも、<br />はじめからでも。</h1>
      <p class="lead">
        <span class="w">ホームページや</span><span class="w">業務の画面を</span><span class="w">いちから作ることも、</span><span class="w">いま動いている</span><span class="w">サイトやシステムの手直し、</span><span class="w">サーバーの用意や</span><span class="w">引っ越し、</span><span class="w">公開後の見守りも、</span><span class="w">少人数のチームが</span><span class="w">お引き受けします。</span>
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contact">メールで相談する（無料）</a>
        <a class="btn s" href="#services">できることを見る</a>
      </div>
    </div>
    <span class="cue">SCROLL</span>
  </section>

  <section class="services" id="services" aria-labelledby="h-services">
    <div class="wrap">
      <p class="sec-no">SERVICES</p>
      <h2 id="h-services" class="sec-title">できること</h2>
      <p class="sec-desc">どれか1つだけでも、組み合わせてもご相談いただけます。</p>
      <ul class="num-list">
        {
          numbered.map((item) => (
            <li>
              <span class="n" aria-hidden="true">{item.n}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="strengths band-dark" aria-labelledby="h-strengths">
    <div class="wrap">
      <p class="sec-no">02 / Why michixsa</p>
      <h2 id="h-strengths" class="sec-title">頼む先を、<br class="sp" />分けなくていい。</h2>
      <ol class="strength-list">
        {
          strengths.map((item) => (
            <li>
              <span class="num">{item.num}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="works" id="samples" aria-labelledby="h-samples">
    <div class="wrap">
      <p class="sec-no">SAMPLES</p>
      <h2 id="h-samples" class="sec-title">サンプル</h2>
      <p class="sec-desc">
        お店のサイトから業務の画面、サーバーの引っ越しの記録まで、私たちが作った架空のサンプルです。実在するお店や会社、実際のお客様の案件ではありません。
      </p>
      <ul class="sample-grid">
        <SampleCard
          href="/lp/cafe/"
          moreHref="/works/sample-cafe-lp/"
          image={cafeCard}
          alt="朝日が差し込む窓際の席に置かれた、コーヒーとバタートースト、開いた本（AIで生成した画像です）"
          tone="cafe"
          kind="喫茶店のLP"
          title="珈琲 ゆうまど"
          body="営業時間とメニュー、行き方がひと目でわかる1ページ。"
          note="画像はAI生成"
        />
        <SampleCard
          href="/lp/kodachi/"
          moreHref="/works/sample-kodachi/"
          tone="kodachi"
          kind="古いサイトの作り直し"
          title="木立造園"
          body="PC向けの古いサイトを、スマートフォンで電話しやすい形に。旧ページと見比べられます。"
          note="写真は仮置き"
        />
        <SampleCard
          href="/demo/mizukane/"
          moreHref="/works/sample-mizukane/"
          tone="mizukane"
          kind="案件管理画面のデモ"
          title="みずかね設備"
          body="工事の案件と予定をまとめる画面。操作でき、入力はこの端末のブラウザにだけ保存されます。"
          note="画面はデモの実物"
        />
        <SampleCard
          href="/lp/hinata/"
          moreHref="/works/sample-hinata/"
          tone="hinata"
          kind="サーバー移転の記録"
          title="ひなた堂印刷"
          body="注文フォームとメールを載せたサーバーの引っ越しを、調査から毎月の報告まで記録しました。"
          note="写真は仮置き"
        />
      </ul>
    </div>
  </section>

  <section class="pricing band-tint" id="pricing" aria-labelledby="h-pricing">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="sec-no">04 / Pricing</p>
          <h2 id="h-pricing" class="sec-title">料金の目安</h2>
        </div>
        <p class="sec-desc">{priceIntro}</p>
      </div>
      <div class="plan-grid">
        {
          plans.map((plan) => (
            <div class="plan">
              <p class="plan-name">{plan.name}</p>
              <p class="plan-price">
                {'prefix' in plan ? plan.prefix : ''}
                <b>{plan.price}</b>
                {plan.unit}
              </p>
              <p class="plan-term">{plan.term}</p>
              <ul>
                {plan.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <details class="price-more">
        <summary>すべての料金を見る</summary>
        <div class="price-groups">
          {
            priceGroups.map((group) => (
              <table class="price-table">
                <caption>{group.caption}</caption>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.name}</th>
                      <td>{row.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ))
          }
        </div>
      </details>
      <p class="works-more"><a class="text-link" href="/pricing/">料金と取引条件のページへ</a></p>
    </div>
  </section>

  <section class="care band-dark" aria-labelledby="h-care">
    <div class="wrap care-in">
      <div class="care-copy">
        <p class="sec-no">05 / After launch</p>
        <h2 id="h-care" class="sec-title">動き出してからも、<br />同じ窓口で。</h2>
        <p>
          サイトもシステムも、公開してからが長い付き合いです。止まっていないか、期限が切れていないかを見守り、ちょっとした更新や不具合の対応を、作ったチームがそのまま続けます。
        </p>
        <p class="care-note">{incidentNote}</p>
      </div>
      <div class="care-plans">
        {
          carePlans.map((plan) => (
            <div class="care-plan">
              <h3>
                {plan.name}
                <span>{plan.price}</span>
              </h3>
              <p>{plan.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="flow" id="flow" aria-labelledby="h-flow">
    <div class="wrap">
      <p class="sec-no">FLOW</p>
      <h2 id="h-flow" class="sec-title">進め方</h2>
      <ol class="chevron-list">
        {
          steps.map((step, index) => (
            <li>
              <span class="st">STEP {index + 1}</span>
              <b>{index === 0 ? 'ご相談' : step.title}</b>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="partners band-tint" id="partners" aria-labelledby="h-partners">
    <div class="wrap partner-in">
      <div class="partner-copy">
        <p class="sec-no">07 / For partners</p>
        <h2 id="h-partners" class="sec-title">手が足りない工程だけでも、<br />お受けします。</h2>
        <p>
          制作会社・開発会社さまからのご依頼もお受けしています。システムの開発や改修、サーバーの構築と移転、公開後の保守など、必要な工程だけをお引き受けできます。
        </p>
        <p class="partner-cta"><a class="text-link" href="/partners/">同業者さま向けのご案内</a></p>
      </div>
      <ol class="partner-list">
        {
          partnerPromises.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="team" id="team" aria-labelledby="h-team">
    <div class="wrap team-in">
      <figure class="team-photo">
        <Image
          src={desk}
          alt="作業机とノートPC（AIで生成した画像です）"
          widths={[480, 800, 1200]}
          sizes="(min-width: 960px) 46vw, 100vw"
          format="avif"
          quality={60}
          loading="lazy"
        />
      </figure>
      <div>
        <p class="sec-no">08 / Team</p>
        <h2 id="h-team" class="sec-title">画面も、しくみも、サーバーも。<br />少人数のチームで受けます。</h2>
        <p>
          michixsa は、サイトやシステムを作る担当と、サーバー・運用の担当がいる少人数のチームです。打ち合わせはすべてオンラインで、全国からご依頼いただけます。窓口はひとつ、話はそのまま作る人に届きます。
        </p>
        <p><a class="text-link" href="/about/">チームについて</a></p>
      </div>
    </div>
  </section>

  <section class="faq band-tint" id="faq" aria-labelledby="h-faq">
    <div class="wrap wrap-narrow">
      <p class="sec-no">09 / FAQ</p>
      <h2 id="h-faq" class="sec-title">よくある質問</h2>
      {
        faqs.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
      <p class="works-more"><a class="text-link" href="/faq/">質問の一覧へ</a></p>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="h-contact">
    <div class="wrap contact-in">
      <h2 id="h-contact" class="contact-title">まずは、メールで<br class="sp" />ご相談ください。</h2>
      <p>「まだ何を頼むか決まっていない」段階でも大丈夫です。今の状況をそのままお送りください。通常2営業日以内にお返事します。</p>
      <a class="btn btn-light btn-lg" href={consultHref}>メールで相談する</a>
      <p class="contact-mail">宛先：info@michixsa.com</p>
      <p><a class="contact-sub" href={partnerHref}>制作会社・開発会社さまのご相談はこちら</a></p>
      <p class="contact-note">相談・見積もり無料｜全国オンライン対応｜対面での打ち合わせは行っていません</p>
      <p class="photo-credit">最初の画面の写真は、AI で生成した画像です。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .team-photo { margin: 0; }
  .team-photo :global(img) { width: 100%; height: auto; border-radius: 20px; }
</style>
