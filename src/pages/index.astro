---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactPanel from '../components/ContactPanel.astro';
import RichText from '../components/RichText.astro';
import { getSortedWorks } from '../data/site';
import { faqs, priceIntro, prices, services, steps, strengths, terms } from '../data/offer';

const samples = (await getSortedWorks()).filter((work) => work.data.kind === 'sample');
---

<BaseLayout>
  <section class="hero container">
    <p class="hero__eyebrow">小さな Web 制作チーム</p>
    <h1>公開した日から、<br /><span class="hero-line"><span class="highlight">止まりにくく速い</span>サイトを。</span></h1>
    <p class="lead">
      michixsa は、LP や小規模なサイトの制作と、公開後の保守・運用をお受けします。静的な作りと、公開前の自動チェックで、表示の速さと止まりにくさを最初から織り込みます。
    </p>
    <div class="actions">
      <a class="button" href="#contact">相談する</a>
      <a class="button button--ghost" href="#terms">料金の目安</a>
    </div>
  </section>

  <section class="container" id="strengths" aria-labelledby="strengths-heading">
    <h2 id="strengths-heading">強み</h2>
    <ul class="grid">
      {
        strengths.map((item) => (
          <li class="panel">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container" id="scope" aria-labelledby="scope-heading">
    <h2 id="scope-heading">対応範囲</h2>
    <ul class="grid">
      {
        services.map((item) => (
          <li class="panel">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container" id="samples" aria-labelledby="samples-heading">
    <h2 id="samples-heading">制作サンプル</h2>
    <p class="notice">
      掲載しているのは架空のサンプルです。実在の店舗・企業の案件ではなく、受託実績ではありません。画像を使っている作例には「AI生成画像」と表示します。
    </p>
    {
      samples.length === 0 ? (
        <p>掲載中の制作サンプルは、まだありません。</p>
      ) : (
        <ul class="grid">
          {samples.map((work) => (
            <li>
              <WorkCard work={work} />
            </li>
          ))}
        </ul>
      )
    }
    <div class="actions">
      <a class="button" href="#contact">相談する</a>
    </div>
  </section>

  <section class="container" id="flow" aria-labelledby="flow-heading">
    <h2 id="flow-heading">制作の流れ</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container" id="terms" aria-labelledby="terms-heading">
    <h2 id="terms-heading">料金の目安・取引条件</h2>
    <p class="lead">{priceIntro}</p>
    <ul class="prices">
      {
        prices.map((item) => (
          <li>
            <p class="price__name">{item.name}</p>
            <p class="price">
              <span class="price__label">目安（税込）</span>
              <span class="price__figures">
                {item.figures.map((figure, index) => (
                  <>
                    {index > 0 && <span class="price__joiner">{item.joiner}</span>}
                    <span class="price__amount">{figure}</span>
                  </>
                ))}
              </span>
            </p>
            {item.note && <p class="price__note">{item.note}</p>}
            <p class="price__includes">{item.includes}</p>
          </li>
        ))
      }
    </ul>

    <h3>取引条件</h3>
    <dl class="terms">
      {
        terms.map((item) => (
          <div>
            <dt>{item.term}</dt>
            <dd>{item.detail}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container" id="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">よくある質問</h2>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>
              <RichText parts={item.parts} />
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="container" id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">お問い合わせ</h2>
    <ContactPanel subheading="h3" />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 0.5rem 0.5rem;
  }

  .hero__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .hero h1 {
    overflow-wrap: normal;
    /* Sized so the second line stays on one row, down to a 320px screen. */
    font-size: clamp(1.25rem, 5.8vw, 2.4rem);
    letter-spacing: 0.01em;
  }

  .hero-line {
    white-space: nowrap;
  }

  .highlight {
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: grid;
    align-content: start;
  }

  .panel {
    padding: 1.15rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .panel h3 {
    margin: 0 0 0.35rem;
    color: var(--heading);
  }

  .panel p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  #samples .notice {
    margin-top: 0;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: 0.15rem 0 0.15rem 3.25rem;
    margin: 0 0 1rem;
  }

  .steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--main-soft);
    color: var(--main);
    font-family: var(--mono);
    font-weight: 700;
  }

  .steps h3 {
    margin: 0;
  }

  .steps p {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .prices {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .prices li {
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .price__name {
    margin: 0;
    font-weight: 700;
    color: var(--heading);
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0.35rem 0 0.2rem;
  }

  .price__label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
  }

  .price__figures {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
  }

  .price__amount {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .price__joiner {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .price__note {
    margin: 0.15rem 0 0;
    font-weight: 700;
  }

  .price__includes {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .terms {
    margin: 0;
  }

  .terms div {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .terms dt {
    font-weight: 700;
  }

  .terms dd {
    margin: 0;
  }

  .faq {
    display: grid;
    gap: 0.5rem;
  }

  .faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding-inline: 1rem;
  }

  .faq summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding-block: 0.6rem;
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    margin-left: auto;
    color: var(--accent);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
  }

  .faq details[open] summary::after {
    content: '–';
  }

  .faq p {
    margin: 0 0 1rem;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .steps {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 1.5rem;
    }

    .prices {
      grid-template-columns: 1fr 1fr;
    }

    .terms div {
      grid-template-columns: 8rem 1fr;
      gap: 1rem;
      align-items: baseline;
    }
  }
</style>
