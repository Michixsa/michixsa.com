---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/lp/cafe/hero.webp';
import { mailHref } from '../data/site';
import {
  carePlans,
  faqs,
  incidentNote,
  partnerPromises,
  plans,
  priceGroups,
  priceIntro,
  services,
  steps,
  strengths,
  upcomingSamples,
} from '../data/offer';

const consultHref = mailHref(
  'ご相談',
  '作りたいもの：\n希望の時期：\nいまのサイトやサーバーの有無：\n',
);
const partnerHref = mailHref(
  '【同業者さま】ご相談',
  'ご依頼したい工程：\n希望の時期：\n秘密保持契約の要否：\n',
);
---

<BaseLayout>
  <section class="hero" id="top">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow">Web制作・システム開発・サーバー運用<span class="eyebrow-break">｜</span>全国オンライン対応</p>
        <h1 class="hero-title">
          <span class="line"><em>途中から</em>でも、</span>
          <span class="line">はじめからでも。</span>
        </h1>
        <p class="lead">
          ホームページや<wbr />業務の画面を<wbr />いちから<wbr />作ることも、<wbr />いま動いている<wbr />サイトや<wbr />システムの<wbr />手直し、<wbr />サーバーの<wbr />用意や<wbr />引っ越し、<wbr />公開後の<wbr />見守りも、<wbr />少人数の<wbr />チームが<wbr />お引き受けします。
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact">メールで相談する（無料）</a>
          <a class="btn btn-ghost" href="#services">できることを見る</a>
        </div>
        <ul class="chips" aria-label="特長">
          <li>相談・見積もり無料</li>
          <li>打ち合わせはオンライン</li>
          <li><a href="#partners">同業者さまからのご依頼も</a></li>
        </ul>
      </div>
      <div class="hero-visual">
        <figure class="device device-pc">
          <div class="device-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <Image
            src={hero}
            alt="カウンターでケトルからコーヒーを注ぐ手元。AI生成画像で、架空のサンプルです"
            widths={[480, 768, 1152]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            format="avif"
            quality={55}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="tag-sample">架空のサンプル</figcaption>
        </figure>
        <figure class="device device-sp">
          <div class="phone-ui">
            <p class="phone-ui__bar">予約管理</p>
            <ul>
              <li><b>9:00</b> 佐藤 様</li>
              <li><b>10:30</b> 高橋 様</li>
              <li><b>11:30</b> 田中 様</li>
            </ul>
          </div>
          <figcaption class="tag-sample">架空</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="services band-tint" id="services" aria-labelledby="h-services">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="sec-no">01 / Services</p>
          <h2 id="h-services" class="sec-title">できること</h2>
        </div>
        <p class="sec-desc">
          作ること、直すこと、動かし続けること。必要なところだけでも、まとめてでもお引き受けします。何を頼めばよいか分からない段階でも、ご相談ください。
        </p>
      </div>
      <div class="svc-grid">
        {
          services.map((item) => (
            <article class="svc">
              <span class:list={['svc-ic', item.icon]} aria-hidden="true" />
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul class="svc-ex">
                {item.examples.map((example) => (
                  <li>{example}</li>
                ))}
              </ul>
              <p class="svc-price">{item.price}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="strengths band-dark" aria-labelledby="h-strengths">
    <div class="wrap">
      <p class="sec-no">02 / Why michixsa</p>
      <h2 id="h-strengths" class="sec-title">頼む先を、<br class="sp" />分けなくていい。</h2>
      <ol class="strength-list">
        {
          strengths.map((item) => (
            <li>
              <span class="num">{item.num}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="works" id="works" aria-labelledby="h-works">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="sec-no">03 / Samples</p>
          <h2 id="h-works" class="sec-title">作れるものの例</h2>
        </div>
        <p class="sec-desc">
          業種ごとに目的を決めて作った<strong>架空のサンプル</strong>です。実在の店舗・企業の案件ではなく、受託実績ではありません。
        </p>
      </div>
      <div class="work-grid">
        <article class="work-card work-feature">
          <a class="work-link" href="/works/sample-cafe-lp/">
            <div class="work-thumb">
              <Image
                src={hero}
                alt=""
                widths={[480, 768]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                format="avif"
                quality={50}
                loading="lazy"
              />
              <span class="tag-sample">架空のサンプル</span>
            </div>
            <div class="work-body">
              <p class="work-meta"><span class="cat">カフェ</span><span class="type">LP・1ページ</span></p>
              <h3>珈琲 ゆうまど</h3>
              <p>写真を主役に、営業時間とアクセスまで迷わず届けるカフェのLP。</p>
              <p class="work-note">写真はAI生成画像です</p>
            </div>
          </a>
        </article>

        {
          upcomingSamples.map((item) => (
            <article class="work-card soon">
              <div class="work-link">
                <div class="work-thumb">
                  <div class="ph"><span>{item.ph}</span></div>
                  <span class="tag-sample">架空のサンプル</span>
                </div>
                <div class="work-body">
                  <p class="work-meta">
                    <span class="cat">{item.cat}</span><span class="type">{item.type}</span>
                  </p>
                  <h3>{item.name}</h3>
                  <p>{item.body}</p>
                  <p class="soon-label">準備中</p>
                </div>
              </div>
            </article>
          ))
        }

        <article class="work-card work-system">
          <a class="work-link" href="/works/sample-clinic-admin/">
            <div class="adm" aria-hidden="true">
              <div class="adm-bar">
                <span class="adm-title">かさね台整骨院　予約管理</span><span class="adm-date">10月14日（水）</span>
              </div>
              <div class="adm-in">
                <ul class="adm-nav">
                  <li class="on">今日の予約</li>
                  <li>週の予約表</li>
                  <li>お知らせ</li>
                </ul>
                <div class="adm-main">
                  <ul class="adm-sum">
                    <li><b>12</b>件の予約</li>
                    <li><b>3</b>枠の空き</li>
                    <li><b>1</b>件の変更</li>
                  </ul>
                  <table class="adm-table">
                    <tr><th>時刻</th><th>お名前</th><th>メニュー</th><th>状態</th></tr>
                    <tr><td>9:00</td><td>佐藤 様</td><td>自費施術 30分</td><td><span class="st st-done">来院済み</span></td></tr>
                    <tr><td>9:30</td><td>鈴木 様</td><td>はじめての方</td><td><span class="st st-done">来院済み</span></td></tr>
                    <tr><td>10:30</td><td>高橋 様</td><td>自費施術 60分</td><td><span class="st">これから</span></td></tr>
                    <tr><td>11:30</td><td>田中 様</td><td>自費施術 30分</td><td><span class="st st-chg">日時変更</span></td></tr>
                  </table>
                </div>
              </div>
              <span class="tag-sample">架空のサンプル（デモデータ）</span>
            </div>
            <div class="work-body">
              <p class="work-meta"><span class="cat">業務システム</span><span class="type">管理画面・4画面</span></p>
              <h3>かさね台整骨院 予約管理</h3>
              <p>
                整骨院LPの「予約する」の先で、院の側が使う画面の例です。今日の予約、1週間の予約表、予約の詳細と変更、お知らせの更新を、画面と解説でお見せします。
              </p>
              <p class="work-note">画面の名前・予約はすべてデモデータです</p>
            </div>
          </a>
        </article>
      </div>
      <p class="works-more"><a class="text-link" href="/works/">作れるものの例 一覧へ</a></p>
    </div>
  </section>

  <section class="pricing band-tint" id="pricing" aria-labelledby="h-pricing">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="sec-no">04 / Pricing</p>
          <h2 id="h-pricing" class="sec-title">料金の目安</h2>
        </div>
        <p class="sec-desc">{priceIntro}</p>
      </div>
      <div class="plan-grid">
        {
          plans.map((plan) => (
            <div class="plan">
              <p class="plan-name">{plan.name}</p>
              <p class="plan-price">
                {'prefix' in plan ? plan.prefix : ''}
                <b>{plan.price}</b>
                {plan.unit}
              </p>
              <p class="plan-term">{plan.term}</p>
              <ul>
                {plan.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <details class="price-more">
        <summary>すべての料金を見る</summary>
        <div class="price-groups">
          {
            priceGroups.map((group) => (
              <table class="price-table">
                <caption>{group.caption}</caption>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.name}</th>
                      <td>{row.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ))
          }
        </div>
      </details>
      <p class="works-more"><a class="text-link" href="/pricing/">料金と取引条件のページへ</a></p>
    </div>
  </section>

  <section class="care band-dark" aria-labelledby="h-care">
    <div class="wrap care-in">
      <div class="care-copy">
        <p class="sec-no">05 / After launch</p>
        <h2 id="h-care" class="sec-title">動き出してからも、<br />同じ窓口で。</h2>
        <p>
          サイトもシステムも、公開してからが長い付き合いです。止まっていないか、期限が切れていないかを見守り、ちょっとした更新や不具合の対応を、作ったチームがそのまま続けます。
        </p>
        <p class="care-note">{incidentNote}</p>
      </div>
      <div class="care-plans">
        {
          carePlans.map((plan) => (
            <div class="care-plan">
              <h3>
                {plan.name}
                <span>{plan.price}</span>
              </h3>
              <p>{plan.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="flow" id="flow" aria-labelledby="h-flow">
    <div class="wrap">
      <p class="sec-no">06 / Flow</p>
      <h2 id="h-flow" class="sec-title">ご相談から公開まで</h2>
      <ol class="flow-list">
        {
          steps.map((step, index) => (
            <li>
              <span>{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="partners band-tint" id="partners" aria-labelledby="h-partners">
    <div class="wrap partner-in">
      <div class="partner-copy">
        <p class="sec-no">07 / For partners</p>
        <h2 id="h-partners" class="sec-title">手が足りない工程だけでも、<br />お受けします。</h2>
        <p>
          制作会社・開発会社さまからのご依頼もお受けしています。システムの開発や改修、サーバーの構築と移転、公開後の保守など、必要な工程だけをお引き受けできます。
        </p>
        <p class="partner-cta"><a class="text-link" href="/partners/">同業者さま向けのご案内</a></p>
      </div>
      <ol class="partner-list">
        {
          partnerPromises.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="team" id="team" aria-labelledby="h-team">
    <div class="wrap team-in">
      <div class="desk" aria-hidden="true">
        <span class="desk__top"></span>
        <span class="desk__screen"></span>
        <span class="desk__book"></span>
      </div>
      <div>
        <p class="sec-no">08 / Team</p>
        <h2 id="h-team" class="sec-title">画面も、しくみも、サーバーも。<br />少人数のチームで受けます。</h2>
        <p>
          michixsa は、サイトやシステムを作る担当と、サーバー・運用の担当がいる少人数のチームです。打ち合わせはすべてオンラインで、全国からご依頼いただけます。窓口はひとつ、話はそのまま作る人に届きます。
        </p>
        <p><a class="text-link" href="/about/">チームについて</a></p>
      </div>
    </div>
  </section>

  <section class="faq band-tint" id="faq" aria-labelledby="h-faq">
    <div class="wrap wrap-narrow">
      <p class="sec-no">09 / FAQ</p>
      <h2 id="h-faq" class="sec-title">よくある質問</h2>
      {
        faqs.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
      <p class="works-more"><a class="text-link" href="/faq/">質問の一覧へ</a></p>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="h-contact">
    <div class="wrap contact-in">
      <h2 id="h-contact" class="contact-title">まずは、メールで<br class="sp" />ご相談ください。</h2>
      <p>「まだ何を頼むか決まっていない」段階でも大丈夫です。今の状況をそのままお送りください。通常2営業日以内にお返事します。</p>
      <a class="btn btn-light btn-lg" href={consultHref}>メールで相談する</a>
      <p class="contact-mail">宛先：info@michixsa.com</p>
      <p><a class="contact-sub" href={partnerHref}>制作会社・開発会社さまのご相談はこちら</a></p>
      <p class="contact-note">相談・見積もり無料｜全国オンライン対応｜対面での打ち合わせは行っていません</p>
    </div>
  </section>
</BaseLayout>

<style>
  .desk {
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    background:
      linear-gradient(#d7e4df, #d7e4df) 18% 22% / 46% 38% no-repeat,
      linear-gradient(#1e3a5f, #1e3a5f) 22% 28% / 38% 26% no-repeat,
      linear-gradient(#0e7c66, #0e7c66) 68% 58% / 18% 8% no-repeat,
      linear-gradient(#c4b39a, #c4b39a) 0 78% / 100% 22% no-repeat,
      #e7eeea;
    position: relative;
  }
</style>
