---
/**
 * Fictional factory recruiting page. No people, interviews, or realistic pay figures.
 */
import { Picture } from 'astro:assets';
import hero from '../../../assets/lp/recruit/recruit-hero.webp';
import measure from '../../../assets/lp/recruit/recruit-measure.webp';
import floor from '../../../assets/lp/recruit/recruit-floor.webp';
import rest from '../../../assets/lp/recruit/recruit-break.webp';
import gear from '../../../assets/lp/recruit/recruit-gear.webp';

const jobs = ['図面を見る', '機械に材料をセット', '加工', '測る', '次の工程へ'];
const day = [
  { time: '8:30', label: '朝礼' },
  { time: '9:00', label: '機械の段取り' },
  { time: '10:00', label: '加工' },
  { time: '12:00', label: '昼休み' },
  { time: '13:00', label: '検査' },
  { time: '16:30', label: '片付け' },
];
const after = ['入社の案内（例）', '道具の渡し方を見る（例）', '先輩の横で作業を見る（例）', '一人で担当する範囲を決める（例）'];
const faqs = [
  { q: '未経験でも大丈夫？', a: '架空の設定では、仕事の流れを最初に教えます。実在の会社の募集ではありません。' },
  { q: '残業は？', a: '架空の設定では、月末に多い日があるとだけ書いています。時間数は置いていません。' },
  { q: '服装は？', a: '架空の設定では、作業服と安全靴を渡します。' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ナガレ精機 製造スタッフ募集（架空のサンプル）｜ものづくりの仕事。</title>
    <meta name="description" content="架空の町工場「ナガレ精機」の採用ページ。人物写真や実在の給与はありません。" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1F2933" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="bar">
      これは架空のサンプルです。「ナガレ精機」は実在しません。給与の数字は置いていません。写真はAI生成画像です。
      <a href="/works/sample-recruit-lp/">解説を見る</a>
    </p>
    <header class="head">
      <a class="logo" href="#top">ナガレ精機</a>
      <a class="btn" href="#apply">応募方法を見る</a>
    </header>
    <main id="top">
      <section class="hero">
        <div>
          <p class="eyebrow">製造スタッフ募集・架空のサンプル</p>
          <h1>ものづくりの仕事、<br />はじめから教えます。</h1>
          <p>金属部品を加工する町工場、という設定です。働く人の顔写真は使っていません。</p>
          <a class="btn" href="#apply">応募方法を見る</a>
        </div>
        <Picture
          src={hero}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[640, 960, 1280]}
          sizes="(min-width: 800px) 50vw, 100vw"
          alt="作業台の上に並んだスパナ、ノギス、金属部品。人はいない。AI生成画像です"
          loading="eager"
          fetchpriority="high"
        />
      </section>

      <section class="section">
        <div class="wrap split">
          <div>
            <h2>仕事内容</h2>
            <ol class="flow">
              {jobs.map((job) => <li>{job}</li>)}
            </ol>
          </div>
          <Picture
            src={measure}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 800]}
            sizes="(min-width: 800px) 40vw, 100vw"
            alt="ノギスが金属部品をはさんで置かれている接写。目盛りは読めない。AI生成画像です"
            loading="lazy"
          />
        </div>
      </section>

      <section class="section section--paper">
        <div class="wrap">
          <h2>一日の流れ</h2>
          <p>時刻は例です。実在の勤務時間ではありません。</p>
          <ol class="day">
            {day.map((item) => (
              <li><span>{item.time}</span>{item.label}（例）</li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section">
        <div class="wrap split">
          <Picture
            src={floor}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[640, 960]}
            sizes="(min-width: 800px) 48vw, 100vw"
            alt="機械が並ぶ工場の通路と、床の黄色い線。人はいない。AI生成画像です"
            loading="lazy"
          />
          <div>
            <h2>職場のようす</h2>
            <p>通路と機械を、写真で見せる想定です。人は写していません。</p>
          </div>
        </div>
      </section>

      <section class="section section--paper">
        <div class="wrap split">
          <div>
            <h2>働きやすさ</h2>
            <p>休憩の席と、作業に使う装備を渡す、という書き方の例です。</p>
          </div>
          <Picture
            src={rest}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 800]}
            sizes="(min-width: 800px) 40vw, 100vw"
            alt="白いテーブルと椅子、電気ポットがある休憩スペース。人はいない。AI生成画像です"
            loading="lazy"
          />
        </div>
      </section>

      <section class="section">
        <div class="wrap split">
          <Picture
            src={gear}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 800]}
            sizes="(min-width: 800px) 40vw, 100vw"
            alt="たたんだ作業服、安全靴、手袋、保護メガネ。ロゴはない。AI生成画像です"
            loading="lazy"
          />
          <div>
            <h2>入社後の流れ</h2>
            <ol>
              {after.map((item) => <li>{item}</li>)}
            </ol>
          </div>
        </div>
      </section>

      <section class="section section--paper" id="faq">
        <div class="wrap">
          <h2>よくある質問</h2>
          <p>インタビューや名前は使っていません。</p>
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section" id="terms">
        <div class="wrap">
          <h2>募集要項</h2>
          <table>
            <tbody>
              <tr><th scope="row">仕事</th><td>製造（架空）</td></tr>
              <tr><th scope="row">給与</th><td>月給 〇〇円（架空）</td></tr>
              <tr><th scope="row">賞与</th><td>〇〇円（架空）</td></tr>
              <tr><th scope="row">休日</th><td>週休2日（架空）</td></tr>
              <tr><th scope="row">場所</th><td>〒000-0000 架空県サンプル市ながれ1-8</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="apply" id="apply">
        <h2>応募方法</h2>
        <p>このサンプルでは応募は送信されません。</p>
        <button class="btn" type="button">応募する（送信されません）</button>
      </section>
    </main>
    <footer class="foot">
      <p>ナガレ精機（架空のサンプル）</p>
      <p>写真はAI生成画像です。人物は写していません。</p>
    </footer>
  </body>
</html>

<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f4f4f2; color: #1a1a1a; font-family: system-ui, "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", Meiryo, sans-serif; font-size: 16px; line-height: 1.75; }
  img { max-width: 100%; height: auto; display: block; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #b93a0a; outline-offset: 3px; }
  .bar { margin: 0; padding: 12px 20px; background: #1f2933; color: #fff; font-size: 14px; }
  .bar a { color: #fff; display: inline-flex; align-items: center; min-height: 48px; }
  .head, .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: center; padding: 8px 20px; }
  .head { background: #fff; }
  .logo { color: #1a1a1a; font-weight: 800; text-decoration: none; min-height: 48px; display: inline-flex; align-items: center; border-bottom: 3px solid #b93a0a; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px; background: #b93a0a; color: #fff; font-weight: 800; text-decoration: none; border: 0; font: inherit; cursor: pointer; }
  .hero, .split { display: grid; gap: 24px; align-items: center; }
  .hero { padding: 32px 20px; }
  h1 { margin: 8px 0; font-size: clamp(32px, 6vw, 48px); line-height: 1.3; }
  h2 { margin: 0 0 12px; font-size: clamp(24px, 4vw, 34px); line-height: 1.35; }
  .eyebrow { margin: 0; font-weight: 800; color: #b93a0a; font-size: 14px; }
  .section { padding: 48px 0; }
  .section--paper { background: #fff; }
  .wrap { width: min(960px, calc(100% - 40px)); margin-inline: auto; }
  .flow, .day { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .flow li, .day li { min-height: 48px; display: flex; align-items: center; gap: 12px; background: #fff; border-left: 4px solid #b93a0a; padding: 8px 12px; font-weight: 700; }
  .day li { background: #f4f4f2; }
  .day span { display: inline-flex; align-items: center; justify-content: center; min-width: 64px; min-height: 36px; background: #f5b700; color: #1a1a1a; font-weight: 800; padding: 0 8px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 12px 8px; border-bottom: 1px solid #ddd; vertical-align: top; }
  th { width: 6rem; }
  details { border-top: 1px solid #ddd; }
  summary { min-height: 48px; display: flex; align-items: center; font-weight: 800; cursor: pointer; }
  .apply, .foot { background: #1f2933; color: #fff; padding: 48px 20px; }
  .apply { text-align: center; }
  .apply .btn { background: #b93a0a; }
  @media (min-width: 800px) {
    .hero, .split { grid-template-columns: 1fr 1fr; }
    .hero { padding-inline: 40px; }
  }
</style>
