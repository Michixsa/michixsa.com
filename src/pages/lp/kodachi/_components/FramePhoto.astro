---
/**
 * Photo frame at a fixed ratio. Swapping the source file keeps the crop.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio: '16-9' | '4-3' | '4-5';
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, ratio, widths, sizes, loading = 'lazy', fetchpriority } = Astro.props;
---

<div class:list={['frame', `ratio-${ratio}`]}>
  <Picture
    src={src}
    formats={['avif']}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
  />
</div>
