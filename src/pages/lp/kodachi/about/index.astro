---
import KodachiLayout from '../../../../layouts/KodachiLayout.astro';
import FramePhoto from '../_components/FramePhoto.astro';
import yard from '../../../../assets/lp/kodachi/about-yard.webp';
---

<KodachiLayout
  title="会社案内"
  description="架空の造園会社「木立造園」の会社案内です。"
  current="about"
>
  <div class="page-intro">
    <p class="eyebrow">会社案内</p>
    <h1>近くの庭を丁寧に手入れします</h1>
    <p>記載している情報は見本です。実在の会社ではありません。</p>
  </div>
  <div class="photo-lead">
    <FramePhoto
      src={yard}
      alt="住宅の塀の前にある松と、家の壁の一部（AIで生成した画像です）"
      ratio="16-9"
      widths={[480, 800, 1024]}
      sizes="(min-width: 1120px) min(56rem, calc(100vw - 80px)), calc(100vw - 32px)"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="narrow block">
    <table class="facts">
      <tbody>
        <tr><th scope="row">名称</th><td>木立造園</td></tr>
        <tr><th scope="row">所在地</th><td>〒000-0000 架空県サンプル市こだち2-8</td></tr>
        <tr><th scope="row">電話</th><td>000-0000-0000</td></tr>
        <tr><th scope="row">メール</th><td>info@example.com</td></tr>
        <tr><th scope="row">仕事</th><td>庭木の手入れ、剪定、庭づくり</td></tr>
      </tbody>
    </table>
  </div>
</KodachiLayout>
