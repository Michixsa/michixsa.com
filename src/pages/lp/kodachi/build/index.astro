---
import KodachiLayout from '../../../../layouts/KodachiLayout.astro';
import FramePhoto from '../_components/FramePhoto.astro';
import plan from '../../../../assets/lp/kodachi/build-plan.webp';

const steps = [
  { title: '庭を見る', body: '木の高さや、人が通る場所を確認します。' },
  { title: '残す木を決める', body: '残す木と、手を入れる場所を分けます。' },
  { title: '図でご説明', body: '作業する範囲を図にして、仕上がりのイメージをお見せします。' },
  { title: '作業', body: '図でお見せした範囲を作業します。' },
  { title: '仕上がりを確認', body: '終わった庭を、その場で一緒に見ます。' },
];
---

<KodachiLayout
  title="庭づくり"
  description="架空の造園会社「木立造園」の庭づくりの段取りです。"
  current="build"
>
  <div class="page-intro">
    <p class="en">GARDEN</p>
    <h1>庭づくり</h1>
    <p>残す木と、新しくする場所を先に決めてから進めます。</p>
  </div>
  <div class="photo-lead">
    <FramePhoto
      src={plan}
      alt="木の台の上の、使い込んだ刈り込みばさみと麻袋、麻縄（AIで生成した画像です）"
      ratio="4-3"
      widths={[480, 768, 1066]}
      sizes="(min-width: 1120px) min(56rem, calc(100vw - 80px)), calc(100vw - 32px)"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="wide block">
    <ol class="phases">
      {
        steps.map((step, index) => (
          <li>
            <span class="n" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p><a class="btn" href="/lp/kodachi/contact/">相談する</a></p>
  </div>
</KodachiLayout>
