---
import KodachiLayout from '../../../../layouts/KodachiLayout.astro';
---

<KodachiLayout
  title="問い合わせ"
  description="架空の造園会社「木立造園」の問い合わせです。送信はされません。"
  current="contact"
>
  <div class="page-intro">
    <p class="en">CONTACT</p>
    <h1>お問い合わせ</h1>
    <p>お電話 000-0000-0000　メール info@example.com</p>
    <p class="note">入力しても送信されません。</p>
    <div>
      <label for="name">お名前</label>
      <input id="name" name="name" type="text" autocomplete="name" />
      <label for="photo">庭の写真</label>
      <input id="photo" name="photo" type="file" accept="image/*" />
      <label for="body">ご相談</label>
      <textarea id="body" name="body" rows="5"></textarea>
      <p><button class="btn" type="button" id="send-demo">送信する</button></p>
      <p id="send-note" aria-live="polite"></p>
    </div>
  </div>
  <script>
    const button = document.getElementById('send-demo');
    const note = document.getElementById('send-note');
    button?.addEventListener('click', () => {
      if (note) note.textContent = 'この見本では、内容は送信されません。';
    });
  </script>
</KodachiLayout>
