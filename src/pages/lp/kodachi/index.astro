---
import { Picture } from 'astro:assets';
import KodachiLayout from '../../../layouts/KodachiLayout.astro';
import FramePhoto from './_components/FramePhoto.astro';
import HeroPhoto from './_components/HeroPhoto.astro';
import heroPc from '../../../assets/lp/kodachi/hero-pc.webp';
import heroSp from '../../../assets/lp/kodachi/hero-sp.webp';
import care from '../../../assets/lp/kodachi/work-care.webp';
import build from '../../../assets/lp/kodachi/work-build.webp';
import pine from '../../../assets/lp/kodachi/examples-pine.webp';
import leaf from '../../../assets/lp/kodachi/strip-leaf.webp';
import stone from '../../../assets/lp/kodachi/strip-stone.webp';
import tools from '../../../assets/lp/kodachi/care-tools.webp';
import azalea from '../../../assets/lp/kodachi/strip-azalea.webp';
import yard from '../../../assets/lp/kodachi/about-yard.webp';
import hedgeWide from '../../../assets/lp/kodachi/examples-hedge.webp';
import gravelWide from '../../../assets/lp/kodachi/examples-gravel.webp';

const heroAlt = '住宅の小さな庭。整えられた松とツツジ、ブロック塀が見える（AIで生成した画像です）';
const services = [
  {
    title: '手入れ・剪定',
    body: '年に一度の剪定から、伸びすぎた木の相談まで。',
    href: '/lp/kodachi/care/',
    image: care,
    alt: '道路沿いに、上面を平らに刈り込んだ常緑の生垣（AIで生成した画像です）',
    widths: [480, 768, 1066],
  },
  {
    title: '庭づくり',
    body: 'ご相談から仕上がりまで、段取りを先に共有します。',
    href: '/lp/kodachi/build/',
    image: build,
    alt: '家の脇の通路に敷いた、明るい灰色の砂利と飛び石（AIで生成した画像です）',
    widths: [480, 768, 1066],
  },
  {
    title: 'その他',
    body: '松の枝の整理や、砂利・飛び石の直しもご相談ください。',
    href: '/lp/kodachi/examples/',
    image: pine,
    alt: '住宅の塀の手前で、枝を短く整えた松（AIで生成した画像です）',
    widths: [480, 800, 1200],
  },
];
const gallery = [
  { image: leaf, alt: '生垣の葉を寄せて見たところ（AIで生成した画像です）', widths: [360, 640, 720] },
  { image: stone, alt: '砂利と飛び石を寄せて見たところ（AIで生成した画像です）', widths: [360, 640, 720] },
  {
    image: tools,
    alt: '木の台に置いた、使い込んだ刈り込みばさみ、剪定ばさみ、折りたたみのこぎり、麻縄と麻袋（AIで生成した画像です）',
    widths: [480, 800, 1200],
  },
  { image: azalea, alt: '軒先のツツジと、家の壁（AIで生成した画像です）', widths: [360, 520] },
];
const quotes = [
  '写真を送ったら、木の高さの目安を文章で返してもらえました。',
  '道路側の生垣を、上の面が揃うように刈ってもらいました。',
  '残す木と、砂利を足す場所を、図で先に見られました。',
];
const steps = [
  { title: '庭を見る', body: '木の高さや、通り道の位置を確認します。' },
  { title: '残す木を決める', body: '残す木と、手を入れる場所を分けます。' },
  { title: '図で共有する', body: '作業の範囲を、図にして共有します。' },
  { title: '作業する', body: '決めた範囲を作業します。' },
  { title: '仕上がりを確認する', body: '終わった庭を、その場で一緒に確認します。' },
];
const faqs = [
  {
    q: '料金の目安はありますか',
    a: '金額は見本です。手入れは、低木（高さ2mまで）1本 3,300円、中木 1本 6,600円、高木 1本 11,000円、生垣 1m 2,200円です。いずれも税込で、写真と本数を見てから改めてお伝えします。',
  },
  {
    q: '庭の写真はどこから送れますか',
    a: '問い合わせのページに、見本の入力欄があります。この見本では、入力しても送信されません。',
  },
  {
    q: '対面で打ち合わせはできますか',
    a: '対面の打ち合わせはしません。やり取りはメールで進めます。',
  },
  {
    q: '受付時間は決まっていますか',
    a: '受付時間と範囲は、ご相談のうえ決めます。',
  },
];
---

<KodachiLayout
  title="庭木の手入れから、庭づくりまで"
  description="架空の造園会社「木立造園」のサイトです。実在の会社ではありません。"
  current="top"
>
  <section class="hero">
    <div class="hero-media">
      <HeroPhoto desktop={heroPc} mobile={heroSp} alt={heroAlt} />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-copy">
      <p class="eyebrow eyebrow-light">町の植木屋</p>
      <h1>庭木の手入れから、<br />庭づくりまで</h1>
      <p class="hero-lead">年に一度の剪定も、伸びすぎた木の相談も。写真を送っていただければ、おおよその目安をお返しします。</p>
      <p><a class="btn" href="/lp/kodachi/contact/">写真を添えて相談する</a></p>
    </div>
    <a class="scroll-down" href="#points">
      <span class="sr">この先の内容へ</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </a>
  </section>

  <section class="section" id="points" data-reveal aria-labelledby="points-heading">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">ご依頼の前に</p>
        <h2 id="points-heading">はじめに知っておくこと</h2>
      </header>
      <div class="points">
        <article>
          <h3>写真を見て目安をお返しします</h3>
          <p>庭の写真を送ってください。本数と高さを見て、おおよその目安をお伝えします。</p>
        </article>
        <article>
          <h3>年に一度の剪定</h3>
          <p>伸びすぎた木も、生垣を揃える仕事も、近くの庭の手入れとしてお受けします。</p>
        </article>
        <article>
          <h3>段取りを先にお伝えします</h3>
          <p>庭づくりは、残す木と変える場所を先に決めて、図にしてから作業します。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-mist" data-reveal aria-labelledby="services-heading">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">仕事内容</p>
        <h2 id="services-heading">主な仕事</h2>
      </header>
      <div class="cards">
        {
          services.map((item) => (
            <article class="card">
              <FramePhoto
                src={item.image}
                alt={item.alt}
                ratio="16-10"
                widths={item.widths}
                sizes="(min-width: 800px) 30vw, calc(100vw - 32px)"
              />
              <div class="card-body">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <p><a class="text-link" href={item.href}>詳しく見る</a></p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gallery" aria-label="庭の写真。すべてAIで生成した画像です">
    {
      gallery.map((item) => (
        <Picture
          src={item.image}
          formats={['avif']}
          fallbackFormat="webp"
          widths={item.widths}
          sizes="(min-width: 800px) 25vw, 50vw"
          alt={item.alt}
        />
      ))
    }
  </section>

  <section class="section" data-reveal aria-labelledby="compare-heading">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">施工事例</p>
        <h2 id="compare-heading">作業の前と後</h2>
        <p class="lead">架空の見本です。同じ庭を、作業の前後で撮り比べた写真ではありません。</p>
      </header>
      <div class="compare">
        <div class="compare-side">
          <Picture
            src={gravelWide}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(min-width: 800px) 50vw, 100vw"
            alt="家の脇の砂利と飛び石（AIで生成した画像です）"
          />
          <span class="badge">作業前</span>
        </div>
        <div class="compare-side">
          <Picture
            src={hedgeWide}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(min-width: 800px) 50vw, 100vw"
            alt="道路沿いに刈り込んだ生垣（AIで生成した画像です）"
          />
          <span class="badge badge-after">作業後</span>
        </div>
      </div>
      <p class="compare-note">左と右は別の場所です。</p>
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="voices-heading">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">お客様の声</p>
        <h2 id="voices-heading">お客様の声</h2>
        <p class="lead">架空の文章です。実在のお客様の声ではありません。</p>
      </header>
      <div class="quotes">
        {
          quotes.map((text) => (
            <figure class="quote">
              <p>「{text}」</p>
              <figcaption>見本の文章</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-mist" data-reveal aria-labelledby="steps-heading">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">進め方</p>
        <h2 id="steps-heading">ご相談から仕上がりまで</h2>
      </header>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="reasons-heading">
    <div class="wrap split">
      <div>
        <p class="eyebrow">ご相談</p>
        <h2 id="reasons-heading">ご相談の進め方</h2>
        <div class="reason">
          <h3>写真を見てから目安をお返しします</h3>
          <p>料金の目安は、お送りいただいた写真と本数を見てからお伝えします。</p>
        </div>
        <div class="reason">
          <h3>残す木を先に決めます</h3>
          <p>手を入れる場所と残す木を分けて、図にしてから作業します。</p>
        </div>
        <div class="reason">
          <h3>メールで進めます</h3>
          <p>対面の打ち合わせはしません。受付時間と範囲は、ご相談のうえ決めます。</p>
        </div>
      </div>
      <FramePhoto
        src={yard}
        alt="住宅の塀の前にある松と、家の壁の一部（AIで生成した画像です）"
        ratio="4-5"
        widths={[480, 720, 1024]}
        sizes="(min-width: 800px) 40vw, calc(100vw - 32px)"
      />
    </div>
  </section>

  <section class="section section-mist" data-reveal aria-labelledby="faq-heading">
    <div class="wrap-narrow">
      <header class="section-head">
        <p class="eyebrow">よくある質問</p>
        <h2 id="faq-heading">よくある質問</h2>
        <p class="lead">答えは見本です。</p>
      </header>
      <div class="faq">
        {
          faqs.map((item, index) => (
            <div class="faq-item">
              <button type="button" aria-expanded="false" aria-controls={`faq-${index}`}>
                <span>{item.q}</span>
                <span class="faq-mark" aria-hidden="true">+</span>
              </button>
              <div class="faq-a" id={`faq-${index}`}>
                <p>{item.a}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-section section-mist" aria-labelledby="cta-heading">
    <div class="cta-card">
      <p class="eyebrow">お問い合わせ</p>
      <h2 id="cta-heading">写真を添えて相談する</h2>
      <p class="lead">電話 000-0000-0000<br />メール info@example.com</p>
      <p><a class="btn" href="/lp/kodachi/contact/">問い合わせページを見る</a></p>
      <p>この見本では、内容は送信されません。</p>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-item button').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('.faq-item');
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', open ? 'false' : 'true');
        item?.classList.toggle('is-open', !open);
      });
    });
  </script>
</KodachiLayout>
