---
import KodachiLayout from '../../../layouts/KodachiLayout.astro';
import FramePhoto from './_components/FramePhoto.astro';
import HeroPhoto from './_components/HeroPhoto.astro';
import heroPc from '../../../assets/lp/kodachi/hero-pc.webp';
import heroSp from '../../../assets/lp/kodachi/hero-sp.webp';
import workCare from '../../../assets/lp/kodachi/work-care.webp';
import workBuild from '../../../assets/lp/kodachi/work-build.webp';
import hedge from '../../../assets/lp/kodachi/examples-hedge.webp';
import pine from '../../../assets/lp/kodachi/examples-pine.webp';
import gravel from '../../../assets/lp/kodachi/examples-gravel.webp';

const heroAlt = '住宅の小さな庭。整えられた松とツツジ、ブロック塀が見える（AIで生成した画像です）';
const works = [
  {
    title: '手入れ・剪定',
    body: '年に一度の剪定から、伸びすぎた木の相談まで。',
    href: '/lp/kodachi/care/',
    image: workCare,
    alt: '道路沿いに、上面を平らに刈り込んだ常緑の生垣（AIで生成した画像です）',
  },
  {
    title: '庭づくり',
    body: 'ご相談から仕上がりまで、段取りを先に共有します。',
    href: '/lp/kodachi/build/',
    image: workBuild,
    alt: '家の脇の通路に敷いた、明るい灰色の砂利と飛び石（AIで生成した画像です）',
  },
];
const examples = [
  {
    href: '/lp/kodachi/examples/#hedge',
    label: '生垣の刈り込み（架空）',
    image: hedge,
    alt: '道路沿いに、上の面を平らに刈り込んだ常緑の生垣（AIで生成した画像です）',
  },
  {
    href: '/lp/kodachi/examples/#pine',
    label: '伸びた松の手入れ（架空）',
    image: pine,
    alt: '住宅の塀の手前で、枝を短く整えた松（AIで生成した画像です）',
  },
  {
    href: '/lp/kodachi/examples/#gravel',
    label: '砂利と飛び石（架空）',
    image: gravel,
    alt: '家の脇の細い通路に敷いた、明るい灰色の砂利と飛び石（AIで生成した画像です）',
  },
];
const steps = ['庭を見る', '残す木と変える場所を決める', '図で共有する', '作業する', '仕上がりを一緒に見る'];
---

<KodachiLayout
  title="庭木の手入れから、庭づくりまで"
  description="架空の造園会社「木立造園」のサイトです。実在の会社ではありません。"
  current="top"
>
  <section class="hero">
    <HeroPhoto desktop={heroPc} mobile={heroSp} alt={heroAlt} />
    <div class="hero-copy">
      <h1>庭木の手入れから、<br />庭づくりまで。</h1>
      <p class="lead">年に一度の剪定も、伸びすぎた木の相談も。写真を送っていただければ、おおよその目安をお返しします。</p>
      <div class="actions">
        <a class="btn" href="/lp/kodachi/contact/">写真を添えて相談する</a>
        <a class="text-link" href="/lp/kodachi/examples/">施工の例を見る</a>
      </div>
    </div>
  </section>

  <section class="block wide" aria-labelledby="work-heading">
    <h2 id="work-heading">仕事</h2>
    <div class="pair">
      {
        works.map((item) => (
          <article>
            <FramePhoto
              src={item.image}
              alt={item.alt}
              ratio="4-3"
              widths={[480, 768, 1066]}
              sizes="(min-width: 800px) 36vw, calc(100vw - 32px)"
            />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p><a class="text-link" href={item.href}>詳しく見る</a></p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="block wide" aria-labelledby="examples-heading">
    <h2 id="examples-heading">施工の例</h2>
    <p>架空の庭を3件、作業のあとで置いています。</p>
    <ul class="strip">
      {
        examples.map((item) => (
          <li>
            <a class="shot" href={item.href}>
              <FramePhoto
                src={item.image}
                alt={item.alt}
                ratio="16-9"
                widths={[360, 640, 800]}
                sizes="(min-width: 800px) 30vw, calc(100vw - 32px)"
              />
              <span class="shot-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block wide" aria-labelledby="steps-heading">
    <h2 id="steps-heading">段取り</h2>
    <ol class="summary">
      {
        steps.map((step, index) => (
          <li>
            <span class="n" aria-hidden="true">{index + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
    <p><a class="text-link" href="/lp/kodachi/build/">段取りの詳細を見る</a></p>
  </section>
</KodachiLayout>
