---
import KodachiLayout from '../../../../layouts/KodachiLayout.astro';
import FramePhoto from '../_components/FramePhoto.astro';
import workCare from '../../../../assets/lp/kodachi/work-care.webp';
import tools from '../../../../assets/lp/kodachi/care-tools.webp';

const rows = [
  ['低木（高さ2mまで）', '1本 3,300円（税込）'],
  ['中木', '1本 6,600円（税込）'],
  ['高木', '1本 11,000円（税込）'],
  ['生垣', '1m 2,200円（税込）'],
];
const flow = [
  { title: '写真を送る', body: '庭の様子が分かる写真を、メールでお送りください。' },
  { title: '高さと本数を確認', body: '写っている木の高さと本数を見ます。' },
  { title: '目安をご連絡', body: '確認した内容をもとに、料金の目安をお返しします。' },
];
---

<KodachiLayout
  title="手入れ・剪定"
  description="架空の造園会社「木立造園」の手入れと剪定の目安です。"
  current="care"
>
  <div class="page-intro">
    <p class="en">CARE</p>
    <h1>手入れ・剪定</h1>
    <p>木の高さと本数で、料金の目安が変わります。</p>
  </div>
  <div class="care-photos">
    <FramePhoto
      src={workCare}
      alt="道路沿いに、上面を平らに刈り込んだ常緑の生垣（AIで生成した画像です）"
      ratio="4-3"
      widths={[480, 768, 1066]}
      sizes="(min-width: 800px) 42vw, calc(100vw - 32px)"
      loading="eager"
      fetchpriority="high"
    />
    <FramePhoto
      src={tools}
      alt="木の台に置いた、使い込んだ刈り込みばさみ、剪定ばさみ、折りたたみのこぎり、麻縄と麻袋（AIで生成した画像です）"
      ratio="16-9"
      widths={[480, 800, 1200]}
      sizes="(min-width: 800px) 32vw, calc(100vw - 32px)"
    />
  </div>
  <div class="narrow block">
    <h2>ご案内の手順</h2>
    <ol class="flow">
      {
        flow.map((step, index) => (
          <li>
            <span class="n" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="narrow block">
    <h2>木の高さの目安</h2>
    <figure class="heights">
      <div class="bars" aria-hidden="true">
        <div><span class="h-low"></span></div>
        <div><span class="h-mid"></span></div>
        <div><span class="h-high"></span></div>
      </div>
      <ul class="bar-names">
        <li>低木<small>2mまで</small></li>
        <li>中木</li>
        <li>高木</li>
      </ul>
      <figcaption>低木は高さ2mまでです。中木と高木はそれより高い木です。どこで分けるかは、写真を見てお伝えします。</figcaption>
    </figure>
    <table class="prices">
      <caption>料金の目安（税込・見本）</caption>
      <tbody>
        {
          rows.map(([name, price]) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{price}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">表の金額は見本です。ご自宅の木に合わせた目安は、写真を見てからご連絡します。</p>
    <p><a class="btn" href="/lp/kodachi/contact/">写真を添えて相談する</a></p>
  </div>
</KodachiLayout>
