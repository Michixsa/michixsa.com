---
/**
 * Fictional osteopathic clinic landing page.
 * No symptoms, treatment claims, testimonials, or before/after photos.
 */
import { Picture } from 'astro:assets';
import hero from '../../../assets/lp/clinic/clinic-hero.webp';
import reception from '../../../assets/lp/clinic/clinic-reception.webp';
import waiting from '../../../assets/lp/clinic/clinic-waiting.webp';

const steps = ['受付', '問診票', '説明', '施術', 'お会計'];
const menu = [
  { name: '自費施術 30分', price: '3,300円（架空・税込）' },
  { name: '自費施術 60分', price: '5,500円（架空・税込）' },
  { name: 'はじめての方', price: '2,200円（架空・税込）' },
];
const faqs = [
  { q: '予約しないと行けませんか？', a: '架空の設定では、予約の人が優先です。このページから予約は送信されません。' },
  { q: '駐車場はありますか？', a: '架空の設定では、2台ぶんあります。' },
  { q: '支払いは何が使えますか？', a: '架空の設定では、現金です。' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>かさね台整骨院（架空のサンプル）｜受付時間と通い方。</title>
    <meta name="description" content="架空の整骨院「かさね台整骨院」のランディングページ。効果の約束や体験談はありません。実在しない院の作例です。" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1F6FA8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="bar">
      これは架空のサンプルです。「かさね台整骨院」は実在しません。症状の説明や効果の約束はありません。写真はAI生成画像です。
      <a href="/works/sample-clinic-lp/">解説を見る</a>
    </p>
    <header class="head">
      <a class="logo" href="#top">かさね台整骨院</a>
      <a class="btn" href="#reserve">予約を見る</a>
    </header>
    <main id="top">
      <section class="hero">
        <div>
          <p class="eyebrow">架空のサンプル</p>
          <h1>受付時間と、<br />通い方がすぐ分かる。</h1>
          <p>住宅地の小さな院、という設定です。施術の効果は書いていません。</p>
          <table>
            <caption>受付時間（架空）</caption>
            <tbody>
              <tr><th scope="row">月・火・木・金</th><td>9:00–12:00 / 15:00–19:00</td></tr>
              <tr><th scope="row">土</th><td>9:00–13:00</td></tr>
              <tr><th scope="row">水・日</th><td>休診</td></tr>
            </tbody>
          </table>
          <p class="actions">
            <a class="btn" href="tel:0000000000">000-0000-0000</a>
            <a class="btn btn--line" href="#reserve">予約を見る</a>
          </p>
        </div>
        <Picture
          src={hero}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[640, 960, 1280]}
          sizes="(min-width: 800px) 48vw, 100vw"
          alt="白い施術ベッドと淡いブルーのカーテンがある施術室。人はいない。AI生成画像です"
          loading="eager"
          fetchpriority="high"
        />
      </section>

      <section class="section">
        <div class="wrap">
          <h2>はじめての方へ</h2>
          <p>来院から帰るまでの流れの例です。施術の方法や技能は書いていません。</p>
          <ol class="steps">
            {steps.map((step, i) => (
              <li><span>{i + 1}</span>{step}</li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section section--blue">
        <div class="wrap">
          <h2>自費施術の内容と費用</h2>
          <p>金額は架空です。症状名や、治るという約束は入れていません。</p>
          <ul class="menu">
            {menu.map((item) => (
              <li><span>{item.name}</span><strong>{item.price}</strong></li>
            ))}
          </ul>
          <h2>主なリスク・注意</h2>
          <p>体の状態によって、向かないことがあります。気になることは、受ける前に聞いてください。この文章は見本で、実際の院では自治体の案内も確認します。</p>
        </div>
      </section>

      <section class="section">
        <div class="wrap split">
          <div>
            <h2>院内のようす</h2>
            <p>待合は木のベンチと観葉植物、という設定です。</p>
          </div>
          <Picture
            src={waiting}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 800]}
            sizes="(min-width: 800px) 40vw, 100vw"
            alt="木のベンチと淡いブルーのクッションがある待合。人はいない。AI生成画像です"
            loading="lazy"
          />
        </div>
      </section>

      <section class="section section--blue" id="hours">
        <div class="wrap split">
          <Picture
            src={reception}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[640, 960]}
            sizes="(min-width: 800px) 46vw, 100vw"
            alt="白い受付カウンターとペン立て。掲示物はない。AI生成画像です"
            loading="lazy"
          />
          <div>
            <h2>受付・予約・駐車場</h2>
            <p>予約の人が優先です。駐車場は架空で2台です。</p>
            <p>〒000-0000 架空県サンプル市かさね台1-2-3</p>
            <p>電話 000-0000-0000</p>
          </div>
        </div>
      </section>

      <section class="section" id="faq">
        <div class="wrap">
          <h2>よくある質問</h2>
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section section--blue" id="reserve">
        <div class="wrap">
          <h2>予約</h2>
          <p>お客様からの予約送信は、このサンプルでは行いません。</p>
          <p>院の側が見る画面の例は、別の架空サンプルです。</p>
          <p><a class="btn" href="/demo/clinic-admin/">院の側の予約画面を見る</a></p>
        </div>
      </section>
    </main>
    <footer class="foot">
      <p>かさね台整骨院（架空のサンプル）</p>
      <p>写真はAI生成画像です。体験談や施術の前後の写真はありません。</p>
    </footer>
  </body>
</html>

<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: #1c2b36; font-family: system-ui, "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", Meiryo, sans-serif; font-size: 18px; line-height: 1.75; }
  img { max-width: 100%; height: auto; display: block; }
  a:focus-visible, summary:focus-visible { outline: 3px solid #1f6fa8; outline-offset: 3px; }
  .bar { margin: 0; padding: 12px 20px; background: #14283f; color: #fff; font-size: 15px; }
  .bar a { color: #fff; display: inline-flex; align-items: center; min-height: 48px; }
  .head, .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: center; padding: 8px 20px; }
  .logo { color: #1f6fa8; font-weight: 800; text-decoration: none; min-height: 48px; display: inline-flex; align-items: center; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 20px; border-radius: 8px; background: #1f6fa8; color: #fff; font-weight: 800; text-decoration: none; }
  .btn--line { background: #fff; color: #1f6fa8; border: 2px solid #1f6fa8; }
  .hero, .split { display: grid; gap: 24px; align-items: center; }
  .hero { padding: 28px 20px; }
  h1 { margin: 8px 0; font-size: clamp(32px, 6vw, 48px); line-height: 1.3; color: #1f6fa8; }
  h2 { margin: 0 0 12px; font-size: clamp(26px, 4vw, 36px); color: #1f6fa8; line-height: 1.35; }
  .eyebrow { margin: 0; font-weight: 800; color: #1f6fa8; font-size: 14px; }
  table { width: 100%; border-collapse: collapse; background: #e6f1f8; font-size: 16px; }
  caption { text-align: left; font-weight: 800; padding: 8px; }
  th, td { text-align: left; padding: 10px 8px; border-top: 1px solid #fff; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .section { padding: 48px 0; }
  .section--blue { background: #f4f9fc; }
  .wrap { width: min(960px, calc(100% - 40px)); margin-inline: auto; }
  .steps { display: grid; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
  .steps li { display: flex; align-items: center; gap: 12px; min-height: 56px; background: #e6f1f8; border-radius: 8px; padding: 8px 12px; font-weight: 800; }
  .steps span { width: 48px; height: 48px; border-radius: 50%; background: #1f6fa8; color: #fff; display: inline-flex; align-items: center; justify-content: center; }
  .menu { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 8px; }
  .menu li { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px solid #d6e0e7; }
  details { border-top: 1px solid #d6e0e7; }
  summary { min-height: 56px; display: flex; align-items: center; font-weight: 800; cursor: pointer; }
  .foot { background: #1c2b36; color: #fff; }
  @media (min-width: 800px) {
    .hero, .split { grid-template-columns: 1fr 1fr; }
    .hero { padding-inline: 40px; }
  }
</style>
