---
/**
 * Fictional café landing page, built as a standalone sample.
 * It owns its whole document on purpose: no portfolio layout, header,
 * theme or View Transitions, so it reads like a real client's site.
 * The shop does not exist; every page view says so and it is noindexed.
 * The illustrations are AI-generated, and the page says that too.
 */
import { Picture } from 'astro:assets';
import hero from '../../../assets/lp/cafe/hero.webp';
import pointDrip from '../../../assets/lp/cafe/point-drip.webp';
import pointCake from '../../../assets/lp/cafe/point-cake.webp';
import pointBeans from '../../../assets/lp/cafe/point-beans.webp';
import banner from '../../../assets/lp/cafe/banner.webp';

const cases = [
  {
    worry: '出勤前に、<br />落ち着いて一杯飲みたい',
    answer: '平日は<em>朝8時</em>から<br />開いています',
    detail: 'モーニングは11時まで',
    pill: 'トースト・ゆで卵つき780円',
  },
  {
    worry: '在宅ワークに、<br />少し飽きてきた',
    answer: '<em>電源・Wi-Fi</em> あり<br />お仕事利用も歓迎',
    detail: '平日の日中は比較的静かです',
    pill: '全12席・予約なしで先着順',
  },
  {
    worry: '本を読みながら、<br />長めに過ごしたい',
    answer: '時間を気にせず<br /><em>自分のペース</em>で',
    detail: 'おかわりのコーヒーは割引に',
    pill: '休日の午後いっぱいでも',
  },
  {
    worry: '家でもおいしい<br />コーヒーを淹れたい',
    answer: '豆は<em>100gから</em><br />量り売り',
    detail: 'その場で好みの挽き方に',
    pill: '淹れ方のコツもお伝えします',
  },
];

const points = [
  {
    label: 'POINT.01',
    title: ['朝に挽いて、', '一杯ずつ', 'ハンドドリップ'],
    body: '豆はその日の朝に挽き、注文を受けてから一杯ずつ淹れます。浅煎りから深煎りまで、季節ごとに入れ替える4種類からお選びください。',
    image: pointDrip,
    alt: 'ケトルからドリッパーにお湯を注ぎ、コーヒーを淹れている手元のイラスト',
    tags: ['季節の4種類', '注文ごとに抽出', '浅煎り〜深煎り'],
  },
  {
    label: 'POINT.02',
    title: ['毎朝焼き上げる、', '自家製', 'バスクチーズケーキ'],
    body: '表面をしっかり焦がした、ほろ苦くて濃厚なチーズケーキです。朝に焼いて、夕方には売り切れることも多い定番です。',
    image: pointCake,
    alt: '焦げ目のついたバスクチーズケーキとブラックコーヒーのイラスト',
    tags: ['毎朝焼き上げ', 'コーヒーと好相性', '数量限定'],
  },
  {
    label: 'POINT.03',
    title: ['豆は100gから、', '好みに合わせて', '量り売り'],
    body: '店頭の豆はすべて100gから買えます。味の好みや、ご自宅の器具を教えていただければ、合う豆と挽き方を一緒に選びます。',
    image: pointBeans,
    alt: '焙煎度の違うコーヒー豆が入ったガラス瓶と、紙袋に豆を移すスコップのイラスト',
    tags: ['100gから', '挽き方を選べる', '試飲できます'],
  },
];

const menu = [
  { name: '本日のハンドドリップ', price: '580', note: '季節ごとに入れ替える4種類から' },
  { name: '自家製バスクチーズケーキ', price: '520', note: '朝に焼いて、夕方には売り切れることも' },
  { name: 'モーニングセット', price: '780', note: '厚切りトースト・ゆで卵・ドリンク（11時まで）' },
];

const steps = [
  { title: '好みを伝える', body: '「酸味が苦手」「家ではフレンチプレス」など、思いつくままに教えてください。' },
  { title: '少しずつ試飲', body: '候補を2〜3種類、少量ずつ飲み比べて選べます。' },
  { title: '挽き方を選ぶ', body: 'ご自宅の器具に合わせて、その場で挽いてお渡しします。豆のままも可能です。' },
  { title: '100gから購入', body: '少しずつ試したい方も、気に入った豆をまとめて買いたい方もどうぞ。' },
];

const faqs = [
  { q: '席の予約はできますか？', a: '予約は受け付けていません。席は先着順でご案内しています。' },
  { q: '小さな子ども連れでも入れますか？', a: 'はい。ベビーカーのまま入れるテーブル席があります。' },
  { q: '支払い方法は何が使えますか？', a: '現金のほか、クレジットカードと電子マネーが使えます。' },
  { q: '豆の配送はしていますか？', a: '現在は店頭での販売のみです。' },
];

const hours = [
  { day: '火〜金', time: '8:00 – 18:00' },
  { day: '土・日・祝', time: '9:00 – 19:00' },
  { day: '定休日', time: '月曜日' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ゆくり珈琲（架空のサンプル）| 朝の一杯を、ゆっくりと。</title>
    <meta
      name="description"
      content="架空の喫茶店「ゆくり珈琲」のランディングページ。実在しない店舗を題材にした Web 制作のサンプルです。"
    />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#2b1d14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="sample-bar" role="note">
      これは制作サンプルです。「ゆくり珈琲」は<strong>架空の店舗</strong>で、実在しません。
      <a href="/works/sample-cafe-lp/">制作の解説を見る</a>
    </p>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="#top">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><ellipse cx="12" cy="12" rx="7" ry="10" transform="rotate(30 12 12)"></ellipse><path
              d="M8 5c4 3 4 11 8 14"></path></svg
          >ゆくり珈琲
        </a>
        <nav aria-label="ページ内">
          <ul>
            <li><a href="#points">こだわり</a></li>
            <li><a href="#menu">メニュー</a></li>
            <li><a href="#faq">よくある質問</a></li>
          </ul>
        </nav>
        <a class="pill pill--small" href="#access">アクセス</a>
      </div>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__text">
          <ul class="hero__tags">
            <li>サンプル駅から徒歩3分</li>
            <li>平日は朝8時から営業</li>
          </ul>
          <p class="hero__lead"><span>＼</span> 出勤前の10分にも <span>／</span></p>
          <h1 id="hero-title">
            朝の一杯を、<br /><span class="marker">ゆっくり</span>と。
          </h1>
          <p class="hero__body">
            住宅街の角にある、12席だけの小さな喫茶店です。豆はその日の朝に挽き、一杯ずつハンドドリップで淹れています。
          </p>
          <ul class="hero__badges">
            <li><small>全</small><strong>12</strong><small>席</small></li>
            <li><small>電源</small><strong class="badge-text">Wi-Fi</strong><small>あり</small></li>
            <li><small>豆は</small><strong>100</strong><small>gから</small></li>
          </ul>
        </div>
        <div class="hero__image">
          <Picture
            src={hero}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(min-width: 860px) 58vw, 100vw"
            alt="朝の光が入る店内で、店主がハンドドリップでコーヒーを淹れているイラスト"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>

      <section class="cta-band" aria-label="ご来店の案内">
        <div class="wrap cta-band__inner">
          <div class="cta">
            <p class="cta__bubble">モーニングは<b>11時</b>まで</p>
            <a class="pill pill--yellow" href="#menu">メニューを見る</a>
          </div>
          <div class="cta">
            <p class="cta__bubble">駅の東口からまっすぐ</p>
            <a class="pill" href="#access">お店の場所を見る</a>
          </div>
        </div>
      </section>

      <section class="section cases" aria-labelledby="cases-title">
        <p class="stripe-title"><span>こんな朝、ありませんか？</span></p>
        <div class="wrap">
          <div class="section-head">
            <p class="label">こんな時に</p>
            <h2 id="cases-title">ゆくり珈琲が、<br class="sp" />ちょうどいい理由</h2>
          </div>
          <ol class="case-list">
            {
              cases.map((c, i) => (
                <li class="case">
                  <p class="case__num">
                    CASE<b>{i + 1}</b>
                  </p>
                  <p class="case__worry" set:html={c.worry} />
                  <svg class="case__arrow" viewBox="0 0 24 16" aria-hidden="true">
                    <path d="M4 2l8 6 8-6M4 8l8 6 8-6" />
                  </svg>
                  <div class="case__answer">
                    <p class="case__title" set:html={c.answer} />
                    <p class="case__detail">{c.detail}</p>
                    <p class="case__pill">{c.pill}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="points" id="points" aria-labelledby="points-title">
        <div class="wrap section-head">
          <p class="lead-bar">小さなお店だから、できること</p>
          <h2 id="points-title">ゆくり珈琲の<br class="sp" /><span class="big">3</span>つのこだわり</h2>
        </div>
        {
          points.map((p, i) => (
            <div class:list={['point', `point--${i + 1}`]}>
              <div class="wrap point__inner">
                <div class="point__text">
                  <p class="point__label">{p.label}</p>
                  <h3>
                    {p.title[0]}
                    <br />
                    <span class="marker">{p.title[1]}</span>
                    {p.title[2]}
                  </h3>
                  <p class="point__body">{p.body}</p>
                  <ul class="point__tags">
                    {p.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
                <div class="point__image">
                  <Picture
                    src={p.image}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[360, 560, 800]}
                    sizes="(min-width: 860px) 420px, 88vw"
                    alt={p.alt}
                  />
                </div>
              </div>
            </div>
          ))
        }
      </section>

      <section class="section menu" id="menu" aria-labelledby="menu-title">
        <div class="wrap">
          <div class="section-head">
            <p class="label">MENU</p>
            <h2 id="menu-title">おすすめのメニュー</h2>
          </div>
          <ul class="menu-list">
            {
              menu.map((m) => (
                <li class="menu-card">
                  <h3>{m.name}</h3>
                  <p class="menu-card__price">
                    <b>{m.price}</b>円
                  </p>
                  <p class="menu-card__note">{m.note}</p>
                </li>
              ))
            }
          </ul>
          <p class="note">価格はすべて税込みです。</p>
        </div>
      </section>

      <section class="banner" aria-labelledby="banner-title">
        <div class="banner__image">
          <Picture
            src={banner}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(min-width: 860px) 50vw, 100vw"
            alt="窓際の席で、本を読みながらコーヒーとトーストを楽しむお客さんのイラスト"
          />
        </div>
        <div class="banner__text">
          <p class="label label--dark">平日の朝も、休日の午後も</p>
          <h2 id="banner-title">いつもの一日を、<br />少しだけ<br class="sp" />ゆっくりに。</h2>
        </div>
      </section>

      <section class="cta-band" aria-label="ご来店の案内">
        <div class="wrap cta-band__inner">
          <div class="cta">
            <p class="cta__bubble">予約なしで、そのままどうぞ</p>
            <a class="pill pill--yellow" href="#access">お店の場所を見る</a>
          </div>
        </div>
      </section>

      <section class="section steps" aria-labelledby="steps-title">
        <div class="wrap">
          <div class="section-head">
            <p class="label">FLOW</p>
            <h2 id="steps-title">豆を買うまでの流れ</h2>
          </div>
          <ol class="step-list">
            {
              steps.map((s, i) => (
                <li class="step">
                  <p class="step__num">
                    STEP<b>{i + 1}</b>
                  </p>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="section faq" id="faq" aria-labelledby="faq-title">
        <div class="wrap narrow">
          <div class="section-head">
            <p class="label">Q&amp;A</p>
            <h2 id="faq-title">よくある質問</h2>
          </div>
          <div class="faq-list">
            {
              faqs.map((f) => (
                <details>
                  <summary>
                    <span class="faq__q">Q.</span>
                    {f.q}
                  </summary>
                  <p>
                    <span class="faq__a">A.</span>
                    {f.a}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section access" id="access" aria-labelledby="access-title">
        <div class="wrap">
          <div class="section-head">
            <p class="label">ACCESS</p>
            <h2 id="access-title">営業時間とアクセス</h2>
          </div>
          <div class="access__grid">
            <svg class="map" viewBox="0 0 320 220" role="img" aria-labelledby="map-title">
              <title id="map-title">サンプル駅の東口から、まっすぐ歩いて3分の角にお店がある案内図</title>
              <rect width="320" height="220" rx="16" fill="#f6ecd9"></rect>
              <path d="M0 150h320M200 0v220M0 60h200" stroke="#fff" stroke-width="18"></path>
              <rect x="16" y="168" width="120" height="36" rx="8" fill="#2b1d14"></rect>
              <text x="76" y="192" text-anchor="middle" fill="#fff" font-size="14" font-weight="700"
                >サンプル駅</text
              >
              <rect x="226" y="80" width="70" height="50" rx="8" fill="#e8d6b8"></rect>
              <rect x="226" y="166" width="78" height="40" rx="8" fill="#e8d6b8"></rect>
              <rect x="40" y="82" width="130" height="50" rx="8" fill="#e8d6b8"></rect>
              <path
                d="M120 168V150h80V70"
                fill="none"
                stroke="#a0521d"
                stroke-width="4"
                stroke-dasharray="2 8"
                stroke-linecap="round"></path>
              <path d="M200 66c-12-14-18-22-18-30a18 18 0 0 1 36 0c0 8-6 16-18 30z" fill="#f5b800"
              ></path>
              <circle cx="200" cy="36" r="7" fill="#2b1d14"></circle>
              <text x="226" y="34" fill="#2b1d14" font-size="14" font-weight="700">ゆくり珈琲</text>
              <text x="146" y="184" fill="#6b4a33" font-size="11">東口から徒歩3分</text>
            </svg>
            <div>
              <dl class="hours">
                {
                  hours.map((h) => (
                    <div>
                      <dt>{h.day}</dt>
                      <dd>{h.time}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="address">
                〒000-0000架空県サンプル市みどり町1-2-3<br />
                サンプル駅 東口から徒歩3分
              </p>
              <p class="note">※ 店名・住所を含め、すべて架空の情報です。</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer__brand">ゆくり珈琲（架空のサンプル）</p>
        <p class="note">
          このページは Web 制作のサンプルとして作成したもので、実在の店舗とは関係ありません。イラストは AI で生成したものです。
          <a href="/works/sample-cafe-lp/">制作の解説</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Scoped to this document only; the portfolio stylesheet is never loaded here. */
  :root {
    --cream: #fdf8ef;
    --paper: #ffffff;
    --tint: #f6ecd9;
    --ink: #2b1d14;
    --muted: #5e4a3b;
    --brown: #8a4416;
    --yellow: #f5b800;
    --yellow-soft: #fff4cc;
    --leaf-soft: #eef3dc;
    --sans: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', 'Yu Gothic', 'Meiryo',
      sans-serif;
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.85;
    overflow-wrap: anywhere;
    font-feature-settings: 'palt';
    letter-spacing: 0.03em;
  }

  h1,
  h2,
  h3 {
    font-weight: 800;
    line-height: 1.45;
    margin: 0;
  }

  p {
    margin: 0;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--brown);
    text-underline-offset: 0.2em;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--brown);
    outline-offset: 3px;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wrap {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .narrow {
    max-width: 760px;
  }

  /* Line breaks that only make sense on narrow screens. */
  @media (min-width: 640px) {
    .sp {
      display: none;
    }
  }

  .note {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .marker {
    background: linear-gradient(transparent 62%, var(--yellow) 62%);
  }

  /* ---------- sample notice and header ---------- */

  .sample-bar {
    padding: 0.5rem 1.25rem;
    background: var(--ink);
    color: var(--cream);
    font-size: 0.8rem;
    text-align: center;
  }

  .sample-bar a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--yellow);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(253 248 239 / 0.94);
    border-bottom: 2px solid var(--ink);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 48px;
    margin-right: auto;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .brand svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: var(--brown);
    stroke: var(--cream);
    stroke-width: 1.6;
  }

  .site-header nav {
    display: none;
  }

  @media (min-width: 860px) {
    .site-header nav {
      display: block;
    }
  }

  .site-header nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .site-header nav a {
    display: block;
    padding: 0.7rem 0.8rem;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }

  /* ---------- buttons ---------- */

  /* Thick outline and a hard offset shadow, so the buttons read as pressable. */
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 56px;
    min-width: min(100%, 17rem);
    padding: 0.7rem 1.75rem;
    border: 3px solid var(--ink);
    border-radius: 12px;
    background: var(--paper);
    box-shadow: 0 5px 0 var(--ink);
    color: var(--ink);
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .pill::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-top: 3px solid currentColor;
    border-right: 3px solid currentColor;
    transform: rotate(45deg);
  }

  .pill:hover {
    transform: translateY(3px);
    box-shadow: 0 2px 0 var(--ink);
  }

  .pill--yellow {
    background: var(--yellow);
  }

  .pill--small {
    min-height: 44px;
    min-width: 0;
    padding: 0.3rem 1rem;
    border-width: 2px;
    border-radius: 999px;
    box-shadow: 0 3px 0 var(--ink);
    font-size: 0.9rem;
    background: var(--yellow);
  }

  .pill--small::after {
    display: none;
  }

  /* ---------- hero ---------- */

  .hero {
    display: grid;
    background: var(--tint);
