---
interface Props {
  /** Sub-pages hide the section heading, as the reference does. */
  heading?: string;
}

const { heading } = Astro.props;
---

<section class="section">
  <div class="container">
    {heading && <h2>{heading}</h2>}
    <ul class="guide">
      <li>
        <a class="guide__card" href="/lp/musubi/system/">
          <span class="guide__icon">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="38" fill="none" stroke="#111" stroke-width="8"></circle>
              <path d="M50 26v26l16 10" fill="none" stroke="#111" stroke-width="8" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="guide__text">はじめての方へ<br />料金・営業時間</span>
          <span class="guide__more">詳しく見る</span>
        </a>
      </li>
      <li>
        <a class="guide__card" href="/lp/musubi/cats/">
          <span class="guide__icon">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <path d="M22 84V40L30 16l16 18h8l16-18 8 24v44z" fill="#111"></path>
              <circle cx="40" cy="54" r="5" fill="#fff"></circle>
              <circle cx="60" cy="54" r="5" fill="#fff"></circle>
            </svg>
          </span>
          <span class="guide__text">家族を待っている<br />猫たち</span>
          <span class="guide__more">詳しく見る</span>
        </a>
      </li>
      <li>
        <a class="guide__card" href="/lp/musubi/about/">
          <span class="guide__icon">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <path
                d="M50 84S16 62 16 38a17 17 0 0 1 34-6 17 17 0 0 1 34 6c0 24-34 46-34 46z"
                fill="none"
                stroke="#111"
                stroke-width="8"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="guide__text">保護猫活動と<br />お迎えまでの流れ</span>
          <span class="guide__more">詳しく見る</span>
        </a>
      </li>
    </ul>
  </div>
</section>
