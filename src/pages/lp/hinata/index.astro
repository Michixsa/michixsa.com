---
/**
 * One-page site for a fictional small-town print shop.
 * Prices, hours, and questions are sample copy and say so.
 * The form stays in the browser and does not send anything.
 * Photos are AI-generated; the bar, footer, and each alt say that.
 */
import { getImage, Picture } from 'astro:assets';
import HinataLayout from '../../../layouts/HinataLayout.astro';
import heroPc from '../../../assets/lp/hinata/hero-pc.webp';
import heroSp from '../../../assets/lp/hinata/hero-sp.webp';
import flyer from '../../../assets/lp/hinata/work-flyer.webp';
import card from '../../../assets/lp/hinata/work-card.webp';
import envelope from '../../../assets/lp/hinata/work-envelope.webp';
import stack from '../../../assets/lp/hinata/examples-stack.webp';
import shop from '../../../assets/lp/hinata/about-shop.webp';

const heroAlt = '白い紙と生成りの紙の束、無地の色票、裁断機が並ぶ、小さな印刷屋の作業台（AIで生成した画像です）';
const heroDesktopWidths = [640, 960, 1280, 1672];
const heroMobileWidths = [480, 800, 1122];
const workWidths = [480, 800, 1200, 1448];
const wideWidths = [640, 960, 1280, 1672];

const [heroDesktopAvif, heroDesktopWebp, heroMobileAvif, heroMobileWebp] = await Promise.all([
  getImage({ src: heroPc, format: 'avif', widths: heroDesktopWidths }),
  getImage({ src: heroPc, format: 'webp', widths: heroDesktopWidths }),
  getImage({ src: heroSp, format: 'avif', widths: heroMobileWidths }),
  getImage({ src: heroSp, format: 'webp', widths: heroMobileWidths }),
]);

const works = [
  {
    title: 'チラシ・ポスター',
    body: 'カラーのチラシと、店頭に置く小さめのポスター。用紙の厚さと部数を相談して決めます。',
    image: flyer,
    alt: '淡い青の無地の紙が、生成りの紙の束の上に少しずれて積まれている（AIで生成した画像です）',
  },
  {
    title: '名刺・カード',
    body: '名刺と、同じ大きさのカード。片面と両面があります。',
    image: card,
    alt: '名刺サイズの白い厚紙と、薄い色の厚紙が、小さな束で並んでいる（AIで生成した画像です）',
  },
  {
    title: '封筒',
    body: '長3と角2を中心に、1色の印刷を受けています。',
    image: envelope,
    alt: '無地の封筒が重なり、1枚だけ開いて中の白い紙が見える（AIで生成した画像です）',
  },
];

const steps = [
  {
    title: '相談する',
    body: '作りたいものと部数、使いたい用紙が決まっていれば、その内容をメールか電話、または店頭で伝えてください。決まっていなければ、見本の紙を見ながら相談できます。',
  },
  {
    title: '入稿する',
    body: '印刷用のデータを送るか、店に持ってきてください。形式の指定は、相談のときに案内します。',
  },
  {
    title: '試し刷りを見る',
    body: '本番の前に、試し刷りを確認してもらいます。色や位置の直しがあれば、この段階で受けます。',
  },
  {
    title: '受け取る',
    body: '店頭で受け取るか、発送を依頼できます。納期の目安は、内容を見てお伝えします。急ぎの指定は、受けられないことがあります。',
  },
];

const prices = [
  { item: '名刺', terms: '両面カラー、100枚', amount: '5,500円' },
  { item: 'チラシ', terms: 'A4、片面カラー、100枚', amount: '7,700円' },
  { item: '封筒', terms: '長3、1色、100枚', amount: '4,400円' },
];

const faqs = [
  {
    question: '何部から頼めますか。',
    answer: '内容によります。名刺やチラシは、100枚をひとつの目安にしています。それより少ない部数も、相談のうえでお返事します。',
  },
  {
    question: 'データは、どの形式で渡せばよいですか。',
    answer: '相談のときに、その仕事に合う形式を案内します。店に原稿を持ってきて、一緒に見ることもできます。',
  },
  {
    question: '納期は、どのくらいですか。',
    answer: '内容と混み具合を見て、その都度お伝えします。短い期日を約束することはしていません。受けられない場合は、その旨を返します。',
  },
];
---

<HinataLayout
  title="チラシ、名刺、封筒の印刷｜ひなた堂印刷（架空のサンプル）"
  description="架空の町の印刷屋の見本です。チラシ、名刺、封筒の少部数の印刷を想定しています。"
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-photo">
      <picture>
        <source
          media="(min-width: 1080px)"
          type="image/avif"
          srcset={heroDesktopAvif.srcSet.attribute}
          sizes="100vw"
        />
        <source
          media="(min-width: 1080px)"
          type="image/webp"
          srcset={heroDesktopWebp.srcSet.attribute}
          sizes="100vw"
        />
        <source type="image/avif" srcset={heroMobileAvif.srcSet.attribute} sizes="100vw" />
        <source type="image/webp" srcset={heroMobileWebp.srcSet.attribute} sizes="100vw" />
        <img
          src={heroMobileWebp.src}
          alt={heroAlt}
          width={heroMobileWebp.attributes.width}
          height={heroMobileWebp.attributes.height}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <div class="hero-panel">
      <p class="kicker">町の印刷屋</p>
      <h1 id="hero-heading">
        <span>チラシ、名刺、</span>
        <span>封筒の印刷。</span>
      </h1>
      <p class="lead">データをもらえれば、用紙と部数の目安をお返しします。少部数から受けています。</p>
      <div class="hero-actions">
        <a class="btn btn-on-ink" href="#contact">相談する</a>
        <a class="text-link" href="#works">仕事を見る</a>
      </div>
    </div>
    <div class="swatch" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </section>

  <section class="section section-surface" id="works" aria-labelledby="works-heading">
    <div class="wrap">
      <h2 id="works-heading">仕事</h2>
      <p class="intro">よく受けている印刷です。これ以外の大きさや部数も、内容を見てお返事します。</p>
      <ul class="works">
        {
          works.map((item) => (
            <li>
              <article class="work-card">
                <Picture
                  src={item.image}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={workWidths}
                  sizes="(min-width: 1080px) 30vw, calc(100vw - 32px)"
                  alt={item.alt}
                  loading="lazy"
                />
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="intro">短い冊子やプログラムも、ページ数を見てお返事します。</p>
    </div>
    <div class="stack">
      <Picture
        src={stack}
        formats={['avif']}
        fallbackFormat="webp"
        widths={wideWidths}
        sizes="100vw"
        alt="作業場の棚に、白い紙と生成りの紙が、高さの違う束で並んでいる（AIで生成した画像です）"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section section-ink" id="flow" aria-labelledby="flow-heading">
    <div class="wrap">
      <h2 id="flow-heading">注文の流れ</h2>
      <ol class="flow">
        {
          steps.map((step, index) => (
            <li>
              <p class="flow-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-surface" id="price" aria-labelledby="price-heading">
    <div class="narrow">
      <h2 id="price-heading">料金の目安</h2>
      <p class="notice">次の金額は、見本のための架空・税込の目安です。実在の料金ではありません。</p>
      <div class="table-wrap">
        <table>
          <caption>架空・税込の目安</caption>
          <thead>
            <tr>
              <th scope="col">内容</th>
              <th scope="col">条件（架空）</th>
              <th class="money" scope="col">目安（税込）</th>
            </tr>
          </thead>
          <tbody>
            {
              prices.map((row) => (
                <tr>
                  <th scope="row">{row.item}</th>
                  <td>{row.terms}</td>
                  <td class="money">{row.amount}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="after">架空・税込の目安です。部数や用紙が違う場合は、その内容で目安を出し直します。送料は含みません。</p>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="wrap about-grid">
      <div class="about-copy">
        <h2 id="about-heading">お店について</h2>
        <p>町のなかにある、小さな印刷屋です。作業場の隣で、用紙の見本を見ながら相談できます。</p>
        <table>
          <caption>お店について（架空）</caption>
          <tbody>
            <tr>
              <th scope="row">屋号</th>
              <td>ひなた堂印刷（架空）</td>
            </tr>
            <tr>
              <th scope="row">住所</th>
              <td>〒000-0000 架空県架空市ひなた1-2-3</td>
            </tr>
            <tr>
              <th scope="row">電話</th>
              <td><a href="tel:000-0000-0000">000-0000-0000</a></td>
            </tr>
            <tr>
              <th scope="row">営業</th>
              <td>平日 9:00–18:00、土曜 9:00–15:00。日曜・祝日は休み</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="about-photo">
        <Picture
          src={shop}
          formats={['avif']}
          fallbackFormat="webp"
          widths={wideWidths}
          sizes="(min-width: 1080px) 46vw, 100vw"
          alt="小さな印刷屋の入口。開いた作業場のドアの向こうに、紙の棚と印刷機が見える（AIで生成した画像です）"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section section-surface" id="faq" aria-labelledby="faq-heading">
    <div class="narrow">
      <h2 id="faq-heading">よくある質問</h2>
      <p class="notice">この質問と回答は、見本のための架空の内容です。</p>
      <dl class="faq">
        {
          faqs.map((item) => (
            <>
              <dt>{item.question}</dt>
              <dd>{item.answer}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-heading">
    <div class="narrow">
      <h2 id="contact-heading">問い合わせ</h2>
      <p>相談の内容を書いて送る見本です。この見本では、内容は送信されません。</p>
      <form id="contact-form" method="post" action="/lp/hinata/">
        <div class="field">
          <label for="contact-name">お名前（必須）</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" aria-required="true" />
        </div>
        <div class="field">
          <label for="contact-route">連絡先（メールまたは電話）（必須）</label>
          <input id="contact-route" name="contact" type="text" autocomplete="on" aria-required="true" />
        </div>
        <div class="field">
          <label for="contact-item">ご希望の印刷物</label>
          <input id="contact-item" name="item" type="text" autocomplete="off" />
        </div>
        <div class="field">
          <label for="contact-count">部数の目安</label>
          <input id="contact-count" name="count" type="text" autocomplete="off" inputmode="numeric" />
        </div>
        <div class="field">
          <label for="contact-body">ご質問</label>
          <textarea id="contact-body" name="body" rows="5" autocomplete="off"></textarea>
        </div>
        <button class="btn" type="submit">内容を送る（見本）</button>
        <p id="contact-live" class="live" aria-live="polite"></p>
      </form>
    </div>
  </section>
</HinataLayout>

<script>
  const form = document.getElementById('contact-form');
  const live = document.getElementById('contact-live');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (live) live.textContent = 'この見本では、内容は送信されません。';
  });
</script>
