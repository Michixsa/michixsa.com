---
import BaseLayout from '../layouts/BaseLayout.astro';
import { mailHref, site } from '../data/site';

const consultHref = mailHref(
  'ご相談',
  '作りたいもの：\n希望の時期：\nいまのサイトやサーバーの有無：\n',
);
const partnerHref = mailHref(
  '【同業者さま】ご相談',
  'ご依頼したい工程：\n希望の時期：\n秘密保持契約の要否：\n',
);

const points = [
  '作りたいもの、または直したいもの',
  '届けたい相手',
  '希望の時期',
  'いまあるサイト、ドメイン、サーバーの有無',
];
---

<BaseLayout
  title="お問い合わせ"
  description="michixsa へのご相談は info@michixsa.com へのメールだけです。相談とお見積もりは無料で、通常2営業日以内に返信します。"
>
  <div class="page-hero">
    <div class="wrap wrap-narrow">
      <h1 class="sec-title">お問い合わせ</h1>
      <p class="lead">
        ご連絡はメールだけです。フォームはありません。全国オンラインで受けていて、対面での打ち合わせは行っていません。
      </p>
    </div>
  </div>
  <section class="page-section">
    <div class="wrap wrap-narrow prose">
      <p>
        <a class="btn btn-primary" href={consultHref}>メールで相談する</a>
      </p>
      <p>宛先：<a href={consultHref}>{site.email}</a></p>
      <p>通常2営業日以内に返信します。相談とお見積もりは無料です。</p>
      <h2>書いていただきたいこと</h2>
      <ul>
        {points.map((item) => <li>{item}</li>)}
      </ul>
      <p>まだ何を頼むか決まっていなくても、大丈夫です。</p>
      <h2>制作会社・開発会社の方</h2>
      <p>件名を「【同業者さま】ご相談」にして送ってください。</p>
      <p><a class="text-link" href={partnerHref}>同業者さま用のメールを書く</a></p>
      <p class="notice">障害時の受付時間や対応範囲は、ご相談のうえ決めます。</p>
    </div>
  </section>
</BaseLayout>
