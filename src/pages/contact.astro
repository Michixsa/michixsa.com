---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
---

<BaseLayout
  title="お問い合わせ"
  description="michixsa へのお問い合わせ。ご相談とお見積もりは無料で、返信の目安は通常2営業日以内です。"
>
  <div class="container narrow">
    <h1>お問い合わせ</h1>
    <ContactPanel />
    <p class="cta"><a class="button button--ghost" href="/#terms">料金の目安を見る</a></p>
  </div>
</BaseLayout>

<style>
  .cta {
    margin-top: 1.5rem;
  }
</style>
