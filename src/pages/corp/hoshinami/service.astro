---
import { Picture } from 'astro:assets';
import HoshinamiLayout from '../../../layouts/HoshinamiLayout.astro';
import tools from '../../../assets/lp/corp/corp-tools.webp';

const items = [
  { title: '給排水', steps: ['現地を見る', '経路を決める', '工事', '水を出して確認'] },
  { title: '空調', steps: ['部屋の広さを見る', '機器を選ぶ', '取り付ける', '運転を確認'] },
  { title: '保守点検', steps: ['予定を決める', '動作を見る', '気になる箇所を伝える', '次の予定を残す'] },
];
---

<HoshinamiLayout
  title="事業内容"
  description="架空の設備工事会社「ほしなみ設備」の事業内容です。"
  current="service"
>
  <h1>事業内容</h1>
  <Picture
    src={tools}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960]}
    sizes="(min-width: 800px) 70vw, 100vw"
    alt="工具箱とパイプレンチ、メジャー。目盛りは写していない。AI生成画像です"
    loading="eager"
  />
  {
    items.map((item) => (
      <section>
        <h2>{item.title}</h2>
        <ol>
          {item.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    ))
  }
</HoshinamiLayout>
