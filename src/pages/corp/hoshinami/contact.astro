---
import { Picture } from 'astro:assets';
import HoshinamiLayout from '../../../layouts/HoshinamiLayout.astro';
import office from '../../../assets/lp/corp/corp-office.webp';
---

<HoshinamiLayout
  title="お問い合わせ"
  description="架空の設備工事会社「ほしなみ設備」のお問い合わせページです。送信はされません。"
  current="contact"
>
  <h1>お問い合わせ</h1>
  <Picture
    src={office}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960]}
    sizes="(min-width: 800px) 70vw, 100vw"
    alt="木の机と椅子、文字のないファイルボックスがある事務所（AIで生成した画像です）"
    loading="eager"
  />
  <p>電話 000-0000-0000</p>
  <p>メール info@example.com</p>
  <p>下の欄は見本です。押しても内容は送られません。</p>
  <form>
    <label for="name">お名前</label>
    <input id="name" name="name" type="text" autocomplete="name" />
    <label for="tel">電話</label>
    <input id="tel" name="tel" type="text" autocomplete="off" />
    <label for="body">ご用件</label>
    <textarea id="body" name="body" rows="5"></textarea>
    <p><button class="btn" type="button" id="send-demo">送信する</button></p>
    <p id="send-note" aria-live="polite"></p>
  </form>
  <script>
    const button = document.getElementById('send-demo');
    const note = document.getElementById('send-note');
    button?.addEventListener('click', () => {
      if (note) note.textContent = 'この見本では、内容は送信されません。';
    });
  </script>
</HoshinamiLayout>
