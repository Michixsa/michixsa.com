---
import { Picture } from 'astro:assets';
import MizukaneLayout from '../../../layouts/MizukaneLayout.astro';
import drawing from '../../../assets/lp/corp/corp-drawing.webp';
---

<MizukaneLayout
  title="会社概要"
  description="架空の設備工事会社「みずかね設備」の会社概要です。沿革は例です。"
  current="about"
>
  <h1>会社概要</h1>
  <Picture
    src={drawing}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[400, 800]}
    sizes="(min-width: 800px) 360px, 100vw"
    alt="文字のない配管の図面と、白いヘルメット、鉛筆（AIで生成した画像です）"
    loading="eager"
  />
  <table>
    <tbody>
      <tr><th scope="row">名称</th><td>みずかね設備（架空）</td></tr>
      <tr><th scope="row">所在地</th><td>〒000-0000 架空県サンプル市みずかね3-1</td></tr>
      <tr><th scope="row">電話</th><td>000-0000-0000</td></tr>
      <tr><th scope="row">仕事</th><td>給排水、空調、保守点検（架空）</td></tr>
    </tbody>
  </table>
  <h2>沿革</h2>
  <ul>
    <li>例：地域で給排水の仕事を始める</li>
    <li>例：空調の仕事を加える</li>
    <li>例：点検の契約を始める</li>
  </ul>
  <p class="muted">沿革は例です。実在の年や件数ではありません。</p>
</MizukaneLayout>
