---
import { Picture } from 'astro:assets';
import MizukaneLayout from '../../../layouts/MizukaneLayout.astro';
import tools from '../../../assets/lp/corp/corp-tools.webp';

const items = [
  {
    title: '給排水',
    body: '家や店の水まわりの配管を、新しくしたり直したりします。',
    steps: ['現地を見る', '経路を決める', '工事', '水を出して確認'],
  },
  {
    title: '空調',
    body: '部屋の空調機器を、取り付けたり入れ替えたりします。',
    steps: ['部屋の広さを見る', '機器を選ぶ', '取り付ける', '運転を確認'],
  },
  {
    title: '保守点検',
    body: '動いている設備を、決めた間隔で見ます。',
    steps: ['予定を決める', '動作を見る', '気になる箇所を伝える', '次の予定を残す'],
  },
];
---

<MizukaneLayout
  title="事業内容"
  description="架空の設備工事会社「みずかね設備」の事業内容です。"
  current="service"
>
  <h1>事業内容</h1>
  <Picture
    src={tools}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960]}
    sizes="(min-width: 800px) 70vw, 100vw"
    alt="工具箱とパイプレンチ、メジャー（AIで生成した画像です）"
    loading="eager"
  />
  {
    items.map((item) => (
      <section>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
        <ol>
          {item.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    ))
  }
</MizukaneLayout>
