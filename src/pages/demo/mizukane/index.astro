---
import {
  TODAY,
  buildJobs,
  customerMap,
  kindLabel,
  statusLabel,
  userById,
  weekDays,
  yen,
} from '../../../demo/mizukane/model';

const jobs = buildJobs();
const customers = customerMap();
const open = jobs.filter((job) => job.status !== 'done' && job.status !== 'cancel');
const due = open.filter((job) => job.due <= TODAY);
const waiting = open.filter((job) => job.status === 'inquiry');
const week = new Set(weekDays());
const scheduled = open.filter((job) => week.has(job.due) && (job.status === 'working' || job.status === 'survey'));
const rows = due.slice(0, 8);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>今日の対応｜みずかね設備 案件管理（架空のサンプル）</title>
    <meta name="description" content="架空の設備会社を想定した、案件管理画面の見本です。データはすべて架空です。" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="return"><a href="/">michixsa のトップへ戻る</a></p>
    <p class="sample">これは架空のサンプルです。「みずかね設備」は実在しません。<a href="/works/sample-mizukane/">解説を見る</a></p>
    <div id="app">
      <p class="banner">
        架空のサンプル。入力した内容はこの端末のブラウザにだけ保存されます。
        <button type="button" data-act="reset">最初の状態に戻す</button>
      </p>
      <div class="layout">
        <nav aria-label="画面">
          <a href="#today" aria-current="page">今日の対応</a>
          <a href="#list">案件</a>
          <a href="#week">予定</a>
          <a href="#customers">顧客</a>
          <a href="#log">記録</a>
          <a href="#import">取り込み</a>
        </nav>
        <div class="main">
          <h1>今日の対応</h1>
          <p>今日行く現場と、返事を待たせている問い合わせ。</p>
          <ul class="counts">
            <li><a href="#list?due=over">{due.length} 件、期限が今日か過ぎています</a></li>
            <li><a href="#list?status=inquiry">{waiting.length} 件、未対応の問い合わせ</a></li>
            <li><a href="#week">{scheduled.length} 件、今週の工事・調査</a></li>
          </ul>
          <button type="button" data-act="error">通信エラーの例を見る</button>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">案件</th>
                  <th scope="col">顧客</th>
                  <th scope="col">種類</th>
                  <th scope="col">状態</th>
                  <th scope="col">担当</th>
                  <th scope="col">期限</th>
                  <th scope="col">金額</th>
                </tr>
              </thead>
              <tbody>
                {
                  rows.map((job) => (
                    <tr>
                      <td data-label="案件"><a href={`#job/${job.id}`}>{job.id}</a></td>
                      <td data-label="顧客">{customers.get(job.customerId)?.name}</td>
                      <td data-label="種類">{kindLabel[job.kind]}</td>
                      <td data-label="状態">{statusLabel[job.status]}</td>
                      <td data-label="担当">{userById(job.ownerId).name}</td>
                      <td data-label="期限">{job.due}</td>
                      <td data-label="金額">{yen(job.yen)}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <dialog id="ask">
      <form method="dialog">
        <h2 id="ask-title">確認</h2>
        <p id="ask-body"></p>
        <div class="row">
          <button value="ok" class="primary" type="submit">この内容で保存する</button>
          <button value="cancel" type="submit">戻る</button>
        </div>
      </form>
    </dialog>
    <script>
      window.addEventListener(
        'load',
        () => {
          void import('../../../demo/mizukane/app').then((mod) => mod.boot());
        },
        { once: true },
      );
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f4f6f8; color: #1c2833; font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", YuGothic, Meiryo, sans-serif; font-size: 16px; line-height: 1.6; }
  a { color: #0f4c81; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid #0f4c81; outline-offset: 2px; }
  .return { margin: 0; background: #1e3a5f; }
  .return a, .sample a { color: #fff; display: inline-flex; align-items: center; min-height: 48px; padding: 0 16px; font-weight: 700; }
  .sample { margin: 0; padding: 8px 16px; background: #0f4c81; color: #fff; }
  .banner { margin: 0; padding: 8px 16px; background: #fff4e5; color: #5c3b00; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .layout { display: grid; }
  nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px; background: #1f3a4d; }
  nav a { color: #fff; text-decoration: none; display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; font-weight: 700; }
  nav a[aria-current='page'] { background: #0f6b4c; }
  .main { padding: 16px; }
  h1 { font-size: 28px; line-height: 1.3; margin: 0 0 8px; }
  h2 { font-size: 20px; }
  .counts { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; }
  .counts a, button, .row a { display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; }
  button { font: inherit; background: #fff; border: 1px solid #8aa; border-radius: 8px; font-weight: 700; }
  button.primary, .banner button { background: #0f6b4c; color: #fff; border-color: #0f6b4c; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #d5dde3; vertical-align: top; }
  td a { display: inline-flex; align-items: center; min-height: 48px; }
  th { background: #e7eef3; }
  .filters, .toolbar, .row { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
  label { display: grid; gap: 4px; font-weight: 700; font-size: 14px; }
  input, select, textarea { font: inherit; min-height: 48px; padding: 8px; border: 1px solid #8aa; border-radius: 8px; background: #fff; }
  textarea { min-height: 96px; }
  .empty, .error { padding: 12px; background: #fff; border: 1px solid #d5dde3; }
  .error { border-color: #8a2b2b; color: #8a2b2b; }
  .week { display: grid; gap: 12px; }
  .week section { background: #fff; padding: 12px; border: 1px solid #d5dde3; }
  dialog { border: 0; border-radius: 12px; padding: 20px; max-width: 28rem; }
  dialog::backdrop { background: rgba(20, 32, 48, .45); }
  @media (min-width: 800px) {
    .layout { grid-template-columns: 200px 1fr; }
    nav { flex-direction: column; }
    .week { grid-template-columns: repeat(7, 1fr); }
  }
  @media (max-width: 700px) {
    .table-wrap table, .table-wrap thead, .table-wrap tbody, .table-wrap tr, .table-wrap td { display: block; }
    .table-wrap thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .table-wrap tr { margin: 0 0 12px; background: #fff; border: 1px solid #d5dde3; }
    .table-wrap td { display: flex; justify-content: space-between; gap: 12px; }
    .table-wrap td::before { content: attr(data-label); font-weight: 700; }
  }
</style>
