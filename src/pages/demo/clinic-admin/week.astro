---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const days = ['月', '火', '水', '木', '金', '土', '日'];
const closed = new Set(['木', '日']);
const hours = ['9:00', '10:00', '11:00', '14:00', '15:00', '16:00'];
const filled: Record<string, string> = {
  '月-9:00': '予約',
  '月-10:00': '予約',
  '火-14:00': '予約',
  '水-9:00': '予約',
  '水-10:00': '予約',
  '水-11:00': '予約',
  '金-15:00': '予約',
  '土-9:00': '予約',
  '土-10:00': '予約',
};
---

<DemoLayout title="1週間の予約表" current="week">
  <p class="muted">10月13日（月）からの1週間です。木・日は休診の例です。</p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>時刻</th>
          {days.map((day) => <th>{day}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          hours.map((hour) => (
            <tr>
              <th scope="row">{hour}</th>
              {days.map((day) => (
                <td>
                  {closed.has(day) ? '休診' : filled[`${day}-${hour}`] ?? '空き'}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</DemoLayout>

<style>
  .scroll { overflow-x: auto; }
  td { white-space: nowrap; }
</style>
