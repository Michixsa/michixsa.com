---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const draft = '10月20日（火）は、設備の点検のため15時で受付を終了します。ご予約は前日までにお願いします。';
---

<DemoLayout title="お知らせの更新" current="news">
  <p class="muted">院のサイトの「お知らせ」に出す文の例です。入力はできません。</p>
  <label for="news">お知らせの文面</label>
  <textarea id="news" readonly>{draft}</textarea>
  <h2>サイトに出る見え方の例</h2>
  <article class="preview">
    <p class="meta">2026年10月8日</p>
    <p>{draft}</p>
  </article>
</DemoLayout>

<style>
  label { display: block; font-weight: 800; margin-bottom: 8px; }
  h2 { font-size: 18px; margin: 20px 0 8px; }
  .preview { border: 1px solid #d6e0e7; border-radius: 8px; padding: 12px 16px; background: #f7fafc; }
  .meta { margin: 0; color: #4b5d6b; font-size: 14px; }
</style>
