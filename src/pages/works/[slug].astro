---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { badgesFor, isFictional, kindLabels } from '../../data/site';

export const getStaticPaths = (async () => {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;
const { title, summary, period, role, tech, kind, links, cover } = work.data;
const { Content } = await render(work);
const isSample = isFictional(kind);
const badges = badgesFor(work.data);
---

<BaseLayout title={title} description={summary} noindex={isSample}>
  <article class="page-section">
    <div class="wrap wrap-narrow work">
    <p class="back"><a class="text-link" href="/works/">← サンプルへ</a></p>
    <header>
      <p class="meta">
        {badges.map((badge) => <span class:list={['badge', `badge--${badge.tone}`]}>{badge.label}</span>)}
        {!isSample && <span>{kindLabels[kind]}</span>}
      </p>
      <h1 class="sec-title">{title}</h1>
      <p class="lead">{summary}</p>
    </header>

    {
      isSample && (
        <p class="notice">
          このページは<strong>架空のサンプル</strong>
          の解説です。登場する店舗・企業は実在せず、受託案件でもありません。制作の考え方を示すための作例です。
        </p>
      )
    }

    {
      work.id === 'sample-kodachi' && (
        <div class="phones">
          <figure>
            <figcaption>再現した旧ページ</figcaption>
            <div class="phone old">
              <p class="band">再現した旧ページ</p>
              <p class="tiny">庭木の剪定、承ります</p>
              <p>本文が小さく、幅が固定です。</p>
            </div>
          </figure>
          <figure>
            <figcaption>新しいサイト</figcaption>
            <div class="phone next">
              <p class="band">木立造園</p>
              <p class="big">庭木の手入れから、庭づくりまで。</p>
              <p class="tap">写真を添えて相談する</p>
            </div>
          </figure>
        </div>
      )
    }

    {cover && <img class="cover" src={cover} alt="" width="760" height="428" />}

    <dl class="facts">
      <div>
        <dt>期間</dt>
        <dd>{period}</dd>
      </div>
      <div>
        <dt>担当</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>使用技術</dt>
        <dd>
          <ul class="tags">{tech.map((t) => <li>{t}</li>)}</ul>
        </dd>
      </div>
    </dl>

    {
      links && links.length > 0 && (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a
                class="btn btn-ghost"
                href={link.href}
                data-astro-reload={link.href.startsWith('/lp/') ? true : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a class="text-link" href="/works/">← サンプルへ</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .work {
    max-width: 760px;
    padding-bottom: 64px;
  }

  .work :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .back {
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .notice {
    margin-top: 1.5rem;
  }

  .cover {
    display: block;
    margin-top: 1.5rem;
    border-radius: var(--radius);
  }

  .facts {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .facts div {
    display: grid;
    gap: 0.25rem;
  }

  @media (min-width: 560px) {
    .facts div {
      grid-template-columns: 6rem 1fr;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    background: var(--tint);
    color: var(--accent-ink);
    font-size: 13px;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 6px;
  }

  .facts dt {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .facts dd {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .prose :global(h2) {
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(li) {
    margin-block: 0.25rem;
  }

  .phones {
    display: grid;
    gap: 16px;
    margin: 24px 0;
  }

  .phones figure {
    margin: 0;
  }

  .phone {
    border: 8px solid #1c2b24;
    border-radius: 24px;
    min-height: 280px;
    padding: 16px;
    background: #fff;
  }

  .phone .band {
    margin: 0 0 12px;
    padding: 8px;
    color: #fff;
    font-weight: 800;
  }

  .old {
    background: #f3f0e8;
  }

  .old .band {
    background: #6a8f4e;
  }

  .old .tiny {
    font-size: 13px;
  }

  .next .band {
    background: #243028;
  }

  .next .big {
    font-size: 20px;
    font-weight: 800;
  }

  .next .tap {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 12px;
    background: #243028;
    color: #fff;
    font-weight: 800;
  }

  @media (min-width: 720px) {
    .phones {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
