---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SampleCard from '../../components/SampleCard.astro';
import cafeCard from '../../assets/lp/cafe/banner.webp';
import kodachiCard from '../../assets/lp/kodachi/garden.webp';
import hinataCard from '../../assets/lp/hinata/bench.webp';
import mizukaneCard from '../../assets/site/mizukane-card.webp';
---

<BaseLayout
  title="サンプル"
  description="michixsa が作った架空のサンプルです。実在するお店や会社、実際のお客様の案件ではありません。"
>
  <div class="page-hero">
    <div class="wrap">
      <h1 class="sec-title">サンプル</h1>
      <p class="lead">
        お店のサイトから業務の画面、サーバーの引っ越しの記録まで、私たちが作った架空のサンプルです。実在するお店や会社、実際のお客様の案件ではありません。
      </p>
    </div>
  </div>
  <section class="works page-section">
    <div class="wrap">
      <ul class="sample-grid">
        <SampleCard
          level="h2"
          href="/lp/cafe/"
          moreHref="/works/sample-cafe-lp/"
          image={cafeCard}
          alt="朝日が差し込む窓際の席に置かれた、コーヒーとバタートースト、開いた本（AIで生成した画像です）"
          tone="cafe"
          kind="喫茶店のLP"
          title="珈琲 ゆうまど"
          body="営業時間とメニュー、行き方がひと目でわかる1ページ。"
          note="画像はAI生成"
        />
        <SampleCard
          level="h2"
          href="/lp/kodachi/"
          moreHref="/works/sample-kodachi/"
          image={kodachiCard}
          alt="手入れを終えた住宅の小さな庭。枝を整えた松とツツジ（AIで生成した画像です）"
          tone="kodachi"
          kind="古いサイトの作り直し"
          title="木立造園"
          body="PC向けの古いサイトを、スマートフォンで電話しやすい形に。旧ページと見比べられます。"
          note="画像はAI生成"
        />
        <SampleCard
          level="h2"
          href="/demo/mizukane/"
          moreHref="/works/sample-mizukane/"
          image={mizukaneCard}
          alt="架空の案件管理画面。今日の対応件数、今日の現場、返事待ちの問い合わせが並ぶ"
          tone="mizukane"
          kind="案件管理画面のデモ"
          title="みずかね設備"
          body="工事の案件と予定をまとめる画面。操作でき、入力はこの端末のブラウザにだけ保存されます。"
          note="画面はデモの実物"
        />
        <SampleCard
          level="h2"
          href="/lp/hinata/"
          moreHref="/works/sample-hinata/"
          image={hinataCard}
          alt="紙の束、色見本、裁断機が並ぶ、小さな印刷所の作業台（AIで生成した画像です）"
          tone="hinata"
          kind="サーバー移転の記録"
          title="ひなた堂印刷"
          body="注文フォームとメールを載せたサーバーの引っ越しを、調査から毎月の報告まで記録しました。"
          note="画像はAI生成"
        />
      </ul>
    </div>
  </section>
</BaseLayout>
