---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getSortedWorks, kindLabels, workKindOrder } from '../../data/site';

const works = await getSortedWorks();
const groups = workKindOrder
  .map((kind) => ({ kind, works: works.filter((w) => w.data.kind === kind) }))
  .filter((group) => group.works.length > 0);
---

<BaseLayout
  title="制作サンプル"
  description="michixsa の制作サンプル。架空の作例について、目的・構成・デザインの判断を説明しています。受託実績ではありません。"
>
  <div class="container">
    <h1>制作サンプル</h1>
    <p class="lead">
      制作の考え方を示すための作例です。実在の店舗・企業・受託案件ではありません。
    </p>

    {
      groups.map((group) => (
        <section aria-labelledby={`kind-${group.kind}`}>
          <h2 id={`kind-${group.kind}`}>{kindLabels[group.kind]}</h2>
          {group.kind === 'sample' && (
            <p class="notice">
              「架空のサンプル」は制作の考え方を示す作例です。実在の店舗・企業・案件ではありません。画像を使っている作例には「AI生成画像」と表示します。
            </p>
          )}
          <ul class="list">
            {group.works.map((work) => (
              <li>
                <WorkCard work={work} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .list > li {
    display: grid;
  }
</style>
